<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no, viewport-fit=cover">
<meta name="theme-color" content="#0f1117">
<title>Video Editor</title>
<style>
  :root{
    --bg:#0f1117; --panel:#161a24; --panel2:#1d2230; --line:#262c3b;
    --text:#e8ebf2; --muted:#8b93a7; --accent:#6c5ce7; --accent2:#a29bfe;
    --clip:#3b82f6; --clipText:#f59e0b; --clipAudio:#10b981;
    --ai1:#8b5cf6; --ai2:#ec4899; --ai3:#06b6d4;
    --left-w:290px; --right-w:300px; --timeline-h:236px;
    --safe-top:env(safe-area-inset-top, 0px);
    --safe-bot:env(safe-area-inset-bottom, 0px);
    --safe-l:env(safe-area-inset-left, 0px);
    --safe-r:env(safe-area-inset-right, 0px);
  }
  *{box-sizing:border-box; -webkit-tap-highlight-color:transparent}
  html,body{height:100%;margin:0;overflow:hidden;overscroll-behavior:none}
  body{font-family:Inter,system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;
    background:var(--bg);color:var(--text);font-size:14px;
    padding:var(--safe-top) var(--safe-r) var(--safe-bot) var(--safe-l);}
  #app{display:flex;flex-direction:column;height:100%}
  #topbar{display:flex;align-items:center;gap:8px;padding:8px 12px;
    background:var(--panel);border-bottom:1px solid var(--line);flex-shrink:0;min-height:52px}
  .brand{font-weight:800;letter-spacing:.4px;font-size:14px;white-space:nowrap}
  .brand span{color:var(--accent2)}
  .spacer{flex:1;min-width:0}
  .btn{background:var(--panel2);color:var(--text);border:1px solid var(--line);
    border-radius:8px;padding:8px 12px;cursor:pointer;font-size:13px;font-weight:600;
    transition:.15s;white-space:nowrap;display:inline-flex;align-items:center;
    gap:5px;justify-content:center;min-height:36px}
  .btn:hover{background:#242b3d}
  .btn.primary{background:var(--accent);border-color:var(--accent)}
  .btn.primary:hover{background:#5b4bd6}
  .btn.rec{background:#2a1520;border-color:#7a2942;color:#ff8ba7}
  .btn.rec.recording{background:#ff2957;border-color:#ff2957;color:#fff;
    animation:pulse 1.2s infinite}
  @keyframes pulse{0%,100%{box-shadow:0 0 0 0 rgba(255,41,87,.7)}
    50%{box-shadow:0 0 0 8px rgba(255,41,87,0)}}
  .btn:disabled{opacity:.5;cursor:not-allowed}
  .btn.sm{padding:5px 10px;font-size:12px;min-height:32px}
  .btn.ai{background:linear-gradient(135deg,var(--ai1),var(--ai2));border:none;color:#fff}
  .btn.ai:hover{filter:brightness(1.1)}
  .btn.icon{padding:0;width:38px;min-height:38px}
  .btn .lbl{display:inline}
  #timeReadout{font-variant-numeric:tabular-nums;color:var(--muted);font-size:11px;
    font-weight:600;padding:0 6px;white-space:nowrap}
  #panelToggleLeft, #panelToggleRight {display:none}

  #body{display:flex;flex:1;min-height:0;position:relative}
  #left{width:var(--left-w);background:var(--panel);
    border-right:1px solid var(--line);display:flex;flex-direction:column;
    min-height:0;flex-shrink:0;z-index:40}
  .panelTabs{display:flex;border-bottom:1px solid var(--line);flex-shrink:0;
    overflow-x:auto;scrollbar-width:none}
  .panelTabs::-webkit-scrollbar{display:none}
  .tab{flex:1;background:none;border:none;color:var(--muted);padding:11px 0;
    cursor:pointer;font-size:10px;font-weight:800;letter-spacing:.4px;
    border-bottom:2px solid transparent;white-space:nowrap;min-width:52px}
  .tab.active{color:var(--text);border-bottom-color:var(--accent)}
  .tab.aiTab.active{border-bottom-color:var(--ai2)}
  .tab.aiTab{color:#a78bfa}
  .tabPane{padding:12px;overflow-y:auto;flex:1;min-height:0;-webkit-overflow-scrolling:touch}
  .tabPane.hidden{display:none}
  #right{width:var(--right-w);background:var(--panel);
    border-left:1px solid var(--line);padding:14px;overflow-y:auto;
    flex-shrink:0;z-index:40;-webkit-overflow-scrolling:touch}
  #right h3{margin:0 0 12px;font-size:12px;text-transform:uppercase;
    letter-spacing:.8px;color:var(--muted)}
  #stage{flex:1;display:flex;flex-direction:column;min-width:0;background:#0b0d13;min-height:0}
  #previewWrap{flex:1;display:flex;align-items:center;justify-content:center;
    padding:14px;min-height:0;min-width:0;overflow:hidden}
  #preview{max-width:100%;max-height:100%;width:auto;height:auto;background:#000;
    border-radius:8px;box-shadow:0 10px 40px rgba(0,0,0,.6);
    aspect-ratio:16/9;object-fit:contain}
  #transport{display:flex;align-items:center;justify-content:center;gap:10px;
    padding:8px;background:var(--panel);border-top:1px solid var(--line);flex-shrink:0}
  #transport button{background:var(--panel2);border:1px solid var(--line);
    color:var(--text);border-radius:8px;width:40px;height:38px;cursor:pointer;
    font-size:14px;display:grid;place-items:center;min-width:40px}
  #transport button:hover{background:#242b3d}
  #playBtn{width:56px!important;background:var(--accent)!important;
    border-color:var(--accent)!important;font-size:16px!important}
  #timecode{font-variant-numeric:tabular-nums;font-weight:700;font-size:13px;
    min-width:74px;text-align:center}

  #dropzone{border:1.5px dashed var(--line);border-radius:10px;padding:16px 10px;
    text-align:center;color:var(--muted);font-size:12px;cursor:pointer;
    margin-bottom:12px;transition:.15s}
  #dropzone:hover,#dropzone.over{border-color:var(--accent);color:var(--accent2);
    background:rgba(108,92,231,.08)}
  .mediaItem{display:flex;gap:9px;align-items:center;padding:7px;border-radius:8px;
    cursor:pointer;margin-bottom:6px;border:1px solid transparent}
  .mediaItem:hover{background:var(--panel2);border-color:var(--line)}
  .mediaItem:active{background:#242b3d}
  .thumb{width:60px;height:36px;border-radius:5px;background:#000 center/cover
    no-repeat;flex-shrink:0;display:grid;place-items:center;font-size:15px;color:#666}
  .mediaItem .meta{min-width:0;flex:1}
  .mediaItem .name{font-size:12px;font-weight:600;white-space:nowrap;
    overflow:hidden;text-overflow:ellipsis}
  .mediaItem .dur{font-size:11px;color:var(--muted);margin-top:2px}
  .mediaItem.ai .thumb{box-shadow:0 0 0 1.5px var(--ai2)}
  .mediaItem.search .thumb{box-shadow:0 0 0 1.5px var(--ai3)}
  .presetBtn{width:100%;text-align:left;background:var(--panel2);
    border:1px solid var(--line);color:var(--text);border-radius:8px;padding:11px 12px;
    cursor:pointer;margin-bottom:8px;font-weight:700;transition:.15s}
  .presetBtn:hover{border-color:var(--accent);background:#242b3d}
  .presetBtn small{display:block;font-weight:400;color:var(--muted);margin-top:2px}
  .actionBtn{width:100%;text-align:center;
    background:linear-gradient(135deg,#6c5ce7,#a29bfe);
    border:none;color:#fff;border-radius:10px;padding:14px;cursor:pointer;
    font-weight:800;font-size:14px;letter-spacing:.3px;margin-bottom:12px;
    transition:.15s;box-shadow:0 4px 14px rgba(108,92,231,.35);min-height:48px}
  .actionBtn:hover{transform:translateY(-1px)}

  .fxSectionTitle{font-size:11px;text-transform:uppercase;letter-spacing:.7px;
    color:var(--muted);font-weight:800;margin:0 0 8px}
  #kitsGrid, #effectsGrid{display:grid;grid-template-columns:1fr 1fr;gap:6px}
  #transGrid{display:grid;grid-template-columns:1fr 1fr 1fr;gap:5px}
  .kitBtn{background:var(--panel2);border:1px solid var(--line);color:var(--text);
    border-radius:8px;padding:8px;cursor:pointer;font-size:11px;text-align:left;
    transition:.15s;font-weight:700;line-height:1.3}
  .kitBtn:hover{border-color:var(--accent);background:#242b3d}
  .kitBtn .kitIcon{font-size:16px;display:block;margin-bottom:2px}
  .kitBtn small{display:block;font-size:9px;color:var(--muted);font-weight:400;
    margin-top:2px;line-height:1.2}
  .fxBtn{background:var(--panel2);border:1px solid var(--line);color:var(--text);
    border-radius:8px;padding:8px 4px;cursor:pointer;font-size:10px;text-align:center;
    transition:.15s;font-weight:600;min-height:54px}
  .fxBtn:hover{border-color:var(--accent);background:#242b3d}
  .fxBtn .fxIcon{font-size:16px;display:block;margin-bottom:2px}
  .fxBtn.active{border-color:var(--accent);background:rgba(108,92,231,.22)}
  .transBtn{background:var(--panel2);border:1px solid var(--line);color:var(--text);
    border-radius:7px;padding:7px 3px;cursor:pointer;font-size:9px;text-align:center;
    transition:.15s;font-weight:600;min-height:50px;line-height:1.15}
  .transBtn:hover{border-color:#f59e0b;background:#2a2418}
  .transBtn .transIcon{font-size:15px;display:block;margin-bottom:2px}
  .transBtn.active{border-color:#f59e0b;background:rgba(245,158,11,.2);color:#fcd34d}

  .fxRow{background:var(--panel2);border:1px solid var(--line);border-radius:6px;
    padding:6px 8px;margin-bottom:5px;font-size:11px}
  .fxRowHead{display:flex;justify-content:space-between;align-items:center;
    margin-bottom:4px;font-weight:700;font-size:11px}
  .fxRowHead button{background:none;border:none;color:var(--muted);cursor:pointer;
    font-size:18px;line-height:1;padding:0 6px}
  .fxRowHead button:hover{color:#ff6b6b}
  .fxRow input[type=range]{width:100%;accent-color:var(--accent);height:6px}
  .fxHint{font-size:10px;color:var(--muted);margin-top:8px;line-height:1.5}

  #props label{display:block;font-size:11px;color:var(--muted);font-weight:700;
    text-transform:uppercase;letter-spacing:.5px;margin:12px 0 5px}
  #props input[type=text],#props input[type=number],#props textarea,#props select{
    width:100%;background:var(--panel2);border:1px solid var(--line);color:var(--text);
    border-radius:7px;padding:9px;font-size:13px;font-family:inherit;min-height:38px}
  #props input[type=range]{width:100%;accent-color:var(--accent);height:6px}
  #props input[type=color]{width:100%;height:38px;background:var(--panel2);
    border:1px solid var(--line);border-radius:7px;cursor:pointer;padding:2px}
  #props .two{display:flex;gap:8px}
  #props .two>div{flex:1}
  .muted{color:var(--muted);font-size:12px;line-height:1.6}
  .infoLine{font-size:11px;color:var(--muted);margin-top:14px;padding-top:12px;
    border-top:1px solid var(--line);font-variant-numeric:tabular-nums}

  .transitionSection{margin-top:16px;padding:12px;border-radius:10px;
    background:linear-gradient(135deg,rgba(245,158,11,.1),rgba(239,68,68,.06));
    border:1px solid rgba(245,158,11,.35)}
  .transitionSection h4{margin:0 0 8px;font-size:11px;font-weight:800;
    letter-spacing:.5px;color:#fcd34d;text-transform:uppercase}
  .transitionSection .noPrev{font-size:11px;color:var(--muted);line-height:1.5;
    font-style:italic}

  .aiHeader{background:linear-gradient(135deg,rgba(139,92,246,.18),rgba(236,72,153,.14));
    border:1px solid rgba(139,92,246,.35);border-radius:10px;padding:10px 12px;margin-bottom:12px}
  .aiHeader h3{margin:0 0 2px;font-size:13px;
    background:linear-gradient(90deg,var(--ai1),var(--ai2));
    -webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent;
    font-weight:800;letter-spacing:.3px}
  .aiHeader p{margin:0;font-size:11px;color:var(--muted)}
  #aiPrompt{width:100%;background:var(--panel2);border:1px solid var(--line);
    color:var(--text);border-radius:8px;padding:9px;font-size:12px;font-family:inherit;
    resize:vertical;min-height:52px}
  #aiPrompt:focus{outline:none;border-color:var(--ai1)}
  .smartToggle{display:flex;align-items:center;gap:8px;margin:8px 0 10px;
    padding:8px 10px;background:linear-gradient(135deg,rgba(6,182,212,.12),rgba(139,92,246,.10));
    border:1px solid rgba(6,182,212,.3);border-radius:8px;cursor:pointer}
  .smartToggle input{accent-color:var(--ai3);width:18px;height:18px;cursor:pointer}
  .smartToggle .stLabel{font-size:11px;font-weight:700;color:#7dd3fc;
    letter-spacing:.3px;flex:1}
  .smartToggle .stSub{font-size:10px;color:var(--muted);font-weight:500;
    display:block;margin-top:1px}
  #aiSearchPanel{margin:8px 0;border:1px solid var(--line);border-radius:8px;
    overflow:hidden;display:none}
  #aiSearchPanel.show{display:block}
  .srHead{display:flex;justify-content:space-between;align-items:center;
    padding:8px 10px;background:var(--panel2);cursor:pointer;
    border-bottom:1px solid var(--line);font-size:11px;font-weight:800;
    letter-spacing:.4px;color:#7dd3fc}
  .srHead .srCount{color:var(--muted);font-weight:600;font-size:10px}
  .srBody{padding:10px;background:#0d1017;max-height:340px;overflow-y:auto;-webkit-overflow-scrolling:touch}
  .srBody.hidden{display:none}
  .srTitle{font-size:12px;font-weight:800;color:#fff;margin-bottom:4px}
  .srTitle a{color:#7dd3fc;text-decoration:none}
  .srSummary{font-size:11px;color:#c4cbd8;line-height:1.5;margin-bottom:8px}
  .srKeywords{display:flex;flex-wrap:wrap;gap:4px;margin-bottom:10px}
  .srKeyword{background:rgba(6,182,212,.16);color:#7dd3fc;
    border:1px solid rgba(6,182,212,.3);font-size:9px;font-weight:700;
    padding:2px 7px;border-radius:10px;text-transform:uppercase;letter-spacing:.4px}
  .srSectionLabel{font-size:9px;font-weight:800;color:var(--muted);
    text-transform:uppercase;letter-spacing:.6px;margin:8px 0 5px}
  .srImagesGrid{display:grid;grid-template-columns:1fr 1fr 1fr;gap:4px}
  .srImgWrap{position:relative;aspect-ratio:1;border-radius:5px;overflow:hidden;
    background:#1a1f2a;cursor:pointer;border:1px solid var(--line)}
  .srImgWrap:hover{border-color:var(--ai3)}
  .srImgWrap img{width:100%;height:100%;object-fit:cover;display:block}
  .srImgWrap .srImgAdd{position:absolute;inset:0;background:rgba(6,182,212,.85);
    color:#fff;display:none;place-items:center;font-size:20px;font-weight:800;
    pointer-events:none}
  .srImgWrap:hover .srImgAdd{display:grid}
  .srImgWrap.loading::before{content:'';position:absolute;inset:0;
    background:linear-gradient(90deg,transparent,rgba(255,255,255,.08),transparent);
    animation:shimmer 1.4s infinite}
  @keyframes shimmer{0%{transform:translateX(-100%)}100%{transform:translateX(100%)}}
  .srRelated{display:flex;flex-wrap:wrap;gap:4px}
  .srRelatedChip{background:var(--panel2);border:1px solid var(--line);
    font-size:10px;color:#c4cbd8;padding:4px 9px;border-radius:10px;cursor:pointer;
    transition:.15s}
  .srRelatedChip:hover{background:#242b3d;color:#fff;border-color:var(--ai3)}
  .srEmpty{font-size:11px;color:var(--muted);padding:8px 0;text-align:center}

  .aiTypeGrid{display:grid;grid-template-columns:1fr 1fr;gap:6px;margin:8px 0}
  .aiTypeBtn{background:var(--panel2);border:1px solid var(--line);color:var(--text);
    border-radius:8px;padding:9px 6px;cursor:pointer;font-size:11px;font-weight:700;
    text-align:center;transition:.15s;min-height:56px}
  .aiTypeBtn:hover{border-color:var(--ai1);background:#242b3d}
  .aiTypeBtn.active{background:linear-gradient(135deg,rgba(139,92,246,.35),rgba(236,72,153,.25));
    border-color:var(--ai2);color:#fff}
  .aiTypeBtn .aiTypeIcon{font-size:16px;display:block;margin-bottom:2px}
  .aiRow{display:flex;gap:6px;margin-bottom:8px;align-items:center}
  .aiRow label{font-size:11px;color:var(--muted);font-weight:700;
    text-transform:uppercase;letter-spacing:.4px;flex-shrink:0}
  .aiRow select,.aiRow input[type=number]{
    flex:1;background:var(--panel2);border:1px solid var(--line);color:var(--text);
    border-radius:6px;padding:8px;font-size:12px;font-family:inherit;min-height:38px}
  .aiBtnRow{display:flex;gap:6px;margin-top:6px}
  .aiGenBtn{flex:1;text-align:center;
    background:linear-gradient(135deg,var(--ai1),var(--ai2),var(--ai3));
    background-size:200% 200%;border:none;color:#fff;border-radius:10px;
    padding:13px;cursor:pointer;font-weight:800;font-size:13px;letter-spacing:.4px;
    transition:.15s;box-shadow:0 4px 16px rgba(139,92,246,.4);
    animation:aiShift 6s ease infinite;min-height:48px}
  .aiSearchBtn{background:linear-gradient(135deg,var(--ai3),#0891b2);
    border:none;color:#fff;border-radius:10px;padding:13px 16px;cursor:pointer;
    font-weight:800;font-size:13px;transition:.15s;
    box-shadow:0 4px 16px rgba(6,182,212,.35);min-height:48px}
  .aiSearchBtn:hover{filter:brightness(1.1)}
  .aiSearchBtn:disabled{opacity:.55;cursor:not-allowed}
  @keyframes aiShift{0%,100%{background-position:0% 50%}50%{background-position:100% 50%}}
  .aiGenBtn:hover{transform:translateY(-1px)}
  .aiGenBtn:disabled{opacity:.55;cursor:not-allowed;animation:none}
  #aiStatus{font-size:11px;color:var(--muted);margin-top:10px;min-height:16px;
    font-weight:600;line-height:1.4}
  #aiStatus.busy{color:var(--ai2)}
  #aiStatus.ok{color:#10b981}
  #aiStatus.err{color:#ff6b6b}
  #aiStatus.search{color:#7dd3fc}
  #aiProgress{height:4px;background:var(--panel2);border-radius:2px;overflow:hidden;
    margin-top:6px;display:none}
  #aiProgress.show{display:block}
  #aiProgressBar{height:100%;width:0%;
    background:linear-gradient(90deg,var(--ai1),var(--ai2));transition:width .15s}
  .aiExamples{margin-top:12px;font-size:11px;color:var(--muted)}
  .aiExamples b{color:var(--text);font-weight:700;display:block;margin-bottom:6px}
  .aiExChip{display:inline-block;background:var(--panel2);border:1px solid var(--line);
    border-radius:12px;padding:5px 10px;margin:0 4px 4px 0;cursor:pointer;
    font-size:10px;color:var(--muted);transition:.15s}
  .aiExChip:hover{background:#242b3d;color:#fff;border-color:var(--ai1)}
  .aiSettings{margin-top:14px;border-top:1px solid var(--line);padding-top:10px}
  .aiSettings summary{cursor:pointer;font-size:11px;color:var(--muted);font-weight:700;
    text-transform:uppercase;letter-spacing:.5px;user-select:none;list-style:none;
    display:flex;align-items:center;gap:6px;padding:6px 0}
  .aiSettings summary::-webkit-details-marker{display:none}
  .aiSettings summary::before{content:'▸';transition:.2s;display:inline-block}
  .aiSettings[open] summary::before{transform:rotate(90deg)}
  .aiSettings .keyField{margin-top:10px}
  .aiSettings input[type=text],.aiSettings input[type=password]{
    width:100%;background:var(--panel2);border:1px solid var(--line);color:var(--text);
    border-radius:6px;padding:8px;font-size:11px;font-family:monospace;min-height:36px}
  .aiSettings small{display:block;font-size:10px;color:var(--muted);margin-top:3px;line-height:1.4}
  .apiToggle{display:flex;align-items:center;gap:8px;margin-top:8px;font-size:11px;
    color:var(--muted);font-weight:600}
  .apiToggle input{accent-color:var(--ai1);width:18px;height:18px}

  #timeline{height:var(--timeline-h);background:var(--panel);
    border-top:1px solid var(--line);display:flex;flex-direction:column;
    flex-shrink:0;min-height:120px}
  #tlToolbar{display:flex;align-items:center;gap:6px;padding:6px 10px;
    border-bottom:1px solid var(--line);flex-shrink:0;overflow-x:auto;scrollbar-width:none}
  #tlToolbar::-webkit-scrollbar{display:none}
  #zoomLabel{font-size:11px;color:var(--muted);min-width:40px;text-align:center;font-weight:600}
  #tlBody{flex:1;display:flex;min-height:0}
  #trackLabels{width:64px;flex-shrink:0;border-right:1px solid var(--line);
    background:var(--panel);padding-top:24px}
  .trackLabel{display:flex;align-items:center;justify-content:center;font-size:9px;
    font-weight:800;letter-spacing:.7px;color:var(--muted);text-transform:uppercase;
    border-bottom:1px solid var(--line)}
  #lanesScroll{flex:1;overflow-x:auto;overflow-y:hidden;position:relative;-webkit-overflow-scrolling:touch}
  #lanes{position:relative;min-width:100%;height:100%}
  #ruler{height:24px;position:relative;border-bottom:1px solid var(--line);
    background:var(--panel2);cursor:pointer;user-select:none}
  .tick{position:absolute;top:0;bottom:0;border-left:1px solid var(--line);
    font-size:10px;color:var(--muted);padding-left:4px;line-height:24px;
    pointer-events:none;font-variant-numeric:tabular-nums}
  #tracks{position:relative}
  .lane{position:relative;border-bottom:1px solid var(--line);background:#12151d}
  .lane:nth-child(1){background:#12151d}
  .lane:nth-child(2){background:#141019}
  .lane:nth-child(3){background:#0f1714}
  .clip{position:absolute;top:3px;bottom:3px;border-radius:6px;background:var(--clip);
    overflow:hidden;cursor:grab;border:1px solid rgba(255,255,255,.14);
    display:flex;align-items:center;background-size:cover;background-position:center}
  .clip.selected{outline:2px solid #fff;outline-offset:1px;z-index:4}
  .clip .clipLabel{font-size:11px;font-weight:700;padding:0 12px;white-space:nowrap;
    overflow:hidden;text-overflow:ellipsis;pointer-events:none;position:relative;
    z-index:1;text-shadow:0 1px 3px rgba(0,0,0,.9)}
  .clip .handle{position:absolute;top:0;bottom:0;width:14px;cursor:ew-resize;
    background:rgba(0,0,0,.3);z-index:2}
  .clip .handle:hover{background:rgba(255,255,255,.35)}
  .clip .handle.left{left:0}
  .clip .handle.right{right:0}
  .clip.text{background:var(--clipText)}
  .clip.audio{background:var(--clipAudio)}
  .clip.ai{box-shadow:inset 0 0 0 2px var(--ai2)}
  .clip.search{box-shadow:inset 0 0 0 2px var(--ai3)}
  .clip .fxBadge{position:absolute;top:3px;right:18px;background:rgba(108,92,231,.9);
    color:#fff;font-size:9px;font-weight:800;padding:1px 5px;border-radius:4px;
    pointer-events:none;z-index:3}
  .clip .aiBadge{position:absolute;top:3px;left:18px;
    background:linear-gradient(135deg,var(--ai1),var(--ai2));
    color:#fff;font-size:9px;font-weight:800;padding:1px 5px;border-radius:4px;
    pointer-events:none;z-index:3}
  .clip .searchBadge{position:absolute;top:3px;left:18px;
    background:linear-gradient(135deg,var(--ai3),#0891b2);
    color:#fff;font-size:9px;font-weight:800;padding:1px 5px;border-radius:4px;
    pointer-events:none;z-index:3}
  .clip .transIndicator{position:absolute;top:0;left:0;bottom:0;width:26px;
    background:linear-gradient(90deg,rgba(245,158,11,.85),rgba(245,158,11,.05));
    pointer-events:none;z-index:2;
    display:flex;align-items:center;justify-content:flex-start;
    font-size:13px;padding-left:4px;text-shadow:0 1px 3px rgba(0,0,0,.7)}
  #playhead{position:absolute;top:0;bottom:0;width:2px;background:#ff4d6d;
    pointer-events:none;z-index:6;box-shadow:0 0 8px rgba(255,77,109,.7)}
  #playhead::before{content:'';position:absolute;top:0;left:-5px;width:12px;
    height:12px;background:#ff4d6d;border-radius:0 0 6px 6px}
  ::-webkit-scrollbar{height:8px;width:8px}
  ::-webkit-scrollbar-track{background:var(--panel)}
  ::-webkit-scrollbar-thumb{background:#2e3648;border-radius:6px}
  ::-webkit-scrollbar-thumb:hover{background:#3b465c}

  .modal{position:fixed;inset:0;background:rgba(0,0,0,.8);z-index:1000;
    display:flex;align-items:center;justify-content:center;backdrop-filter:blur(4px);padding:10px}
  .modal.hidden{display:none}
  .modalContent{background:var(--panel);border:1px solid var(--line);border-radius:12px;
    padding:12px;width:min(96vw,1100px);max-height:96vh;display:flex;
    flex-direction:column;box-shadow:0 20px 60px rgba(0,0,0,.6)}
  .modalHeader{display:flex;justify-content:space-between;align-items:center;margin-bottom:10px}
  .modalHeader h2{margin:0;font-size:15px}
  .modalHeader button{background:none;border:none;color:var(--muted);cursor:pointer;
    font-size:26px;line-height:1;padding:0 6px}
  .modalHeader button:hover{color:#fff}
  #drawCanvas{width:100%;height:auto;max-height:65vh;
    background:repeating-conic-gradient(#2a2f3d 0% 25%, #232838 0% 50%) 50% / 24px 24px;
    border-radius:8px;cursor:crosshair;touch-action:none;border:1px solid var(--line);
    object-fit:contain}
  .drawToolbar{display:flex;gap:8px;align-items:center;margin-top:10px;flex-wrap:wrap}
  .drawToolbar input[type=color]{width:44px;height:38px;background:var(--panel2);
    border:1px solid var(--line);border-radius:7px;cursor:pointer;padding:2px}
  .drawToolbar input[type=range]{flex:1;min-width:100px;accent-color:var(--accent);height:6px}
  .drawToolbar button{background:var(--panel2);border:1px solid var(--line);
    color:var(--text);border-radius:8px;padding:9px 12px;cursor:pointer;
    font-weight:600;font-size:13px;min-height:40px}
  .drawToolbar button:hover{background:#242b3d}
  .drawToolbar button.active{background:var(--accent);border-color:var(--accent);color:#fff}
  .drawToolbar button.primary{background:var(--accent);border-color:var(--accent)}
  .drawToolbar .brushPreview{width:38px;height:38px;border-radius:50%;
    background:#000;border:2px solid var(--line);display:grid;place-items:center;flex-shrink:0}
  .drawToolbar .brushPreview span{border-radius:50%;background:#fff;display:block}
  .drawToolbar label{font-size:11px;color:var(--muted);font-weight:700;
    text-transform:uppercase;letter-spacing:.5px}

  #exportModal .modalContent{width:min(94vw,520px)}
  .fmtOption{display:flex;gap:12px;align-items:flex-start;padding:14px;
    border:1.5px solid var(--line);border-radius:10px;cursor:pointer;margin-bottom:10px;
    transition:.15s;background:var(--panel2)}
  .fmtOption:hover{border-color:var(--accent);background:#242b3d}
  .fmtOption.selected{border-color:var(--accent);background:rgba(108,92,231,.15)}
  .fmtIcon{font-size:26px;line-height:1;flex-shrink:0}
  .fmtInfo{flex:1;min-width:0}
  .fmtName{font-weight:800;font-size:14px;margin-bottom:3px;display:flex;
    align-items:center;gap:8px}
  .fmtBadge{font-size:9px;font-weight:800;padding:2px 6px;border-radius:6px;
    letter-spacing:.4px}
  .fmtBadge.fast{background:rgba(16,185,129,.2);color:#10b981}
  .fmtBadge.universal{background:rgba(139,92,246,.25);color:#a78bfa}
  .fmtDesc{font-size:11px;color:var(--muted);line-height:1.5}

  #exportProgress{display:none;margin-top:14px}
  #exportProgress.show{display:block}
  .epStep{font-size:12px;color:var(--muted);margin-bottom:6px;font-weight:600;
    display:flex;justify-content:space-between;align-items:center}
  .epStep.active{color:var(--text)}
  .epStep.done{color:#10b981}
  .epBar{height:6px;background:var(--panel2);border-radius:3px;overflow:hidden;margin-bottom:10px}
  .epBarFill{height:100%;width:0%;background:linear-gradient(90deg,var(--accent),var(--accent2));
    transition:width .2s}

  #drawerBackdrop{display:none;position:fixed;inset:0;background:rgba(0,0,0,.55);
    z-index:39;backdrop-filter:blur(2px)}
  #drawerBackdrop.show{display:block}

  @media (max-width: 1100px){
    :root{ --left-w:250px; --right-w:270px; --timeline-h:220px; }
    #previewWrap{padding:10px}
  }
  @media (max-width: 900px){
    :root{ --left-w:280px; --right-w:320px; --timeline-h:200px; }
    #panelToggleRight{display:inline-flex}
    #right{position:fixed;top:0;bottom:0;right:0;width:var(--right-w);
      transform:translateX(100%);transition:transform .25s ease;
      box-shadow:-10px 0 30px rgba(0,0,0,.5);padding-top:calc(14px + var(--safe-top));
      padding-bottom:calc(14px + var(--safe-bot));z-index:41}
    #right.open{transform:translateX(0)}
    .brand{font-size:13px}
  }
  @media (max-width: 720px){
    :root{ --left-w:86vw; --right-w:86vw; --timeline-h:170px; }
    #topbar{padding:6px 8px;gap:6px;min-height:48px}
    .brand .brandFull{display:none}
    .brand::after{content:'🎬 VE';font-size:14px}
    .brand span{display:none}
    .brand{font-size:0}
    .btn{padding:7px 10px;font-size:12px;min-height:34px}
    .btn .lbl{display:none}
    .btn.ai .lbl, .btn.rec .lbl, .btn.primary .lbl{display:inline}
    #timeReadout{display:none}
    #panelToggleLeft{display:inline-flex}
    #left{position:fixed;top:0;bottom:0;left:0;width:var(--left-w);
      transform:translateX(-100%);transition:transform .25s ease;
      box-shadow:10px 0 30px rgba(0,0,0,.5);
      padding-top:var(--safe-top);padding-bottom:var(--safe-bot);z-index:41}
    #left.open{transform:translateX(0)}
    .tabPane{padding:10px}
    #previewWrap{padding:6px}
    #preview{border-radius:6px}
    #transport{padding:6px;gap:6px}
    #transport button{width:38px;height:34px;font-size:13px;min-width:38px}
    #playBtn{width:50px!important}
    #timecode{font-size:12px;min-width:64px}
    #trackLabels{width:52px}
    .trackLabel{font-size:8px}
    #tlToolbar{padding:5px 8px;gap:4px}
    .clip .handle{width:16px}
    #ruler{height:20px}
    .tick{line-height:20px;font-size:9px}
    .modalContent{padding:10px;border-radius:10px;max-height:98vh}
    #drawCanvas{max-height:60vh}
    .srImagesGrid{grid-template-columns:1fr 1fr}
    #transGrid{grid-template-columns:1fr 1fr 1fr 1fr}
  }
  @media (max-width: 420px){
    :root{ --timeline-h:150px; }
    #topbar{padding:5px 6px;gap:4px}
    .btn{padding:6px 8px;font-size:11px}
    #transport button{width:34px;height:30px;font-size:12px;min-width:34px}
    #playBtn{width:44px!important}
    #timecode{font-size:11px;min-width:56px}
    .thumb{width:50px;height:30px}
    .kitBtn{padding:6px;font-size:10px}
    .fxBtn{padding:6px 2px;font-size:9px;min-height:48px}
    .drawToolbar{gap:6px}
    .drawToolbar button{padding:7px 10px;font-size:12px}
  }
  @media (max-height: 500px) and (orientation: landscape){
    :root{ --timeline-h:120px; }
    #topbar{min-height:42px;padding:4px 8px}
    #previewWrap{padding:4px}
    #transport{padding:4px;gap:4px}
    #transport button{width:34px;height:28px;font-size:12px}
    #playBtn{width:42px!important}
  }
  @media (min-width: 1600px){
    :root{ --left-w:320px; --right-w:340px; --timeline-h:260px; }
  }
  @media (hover: none){
    .clip .handle{width:18px}
    .mediaItem{padding:9px 7px}
    .fxRowHead button{padding:0 10px;font-size:22px}
  }
</style>
</head>
<body>
<div id="app">

  <header id="topbar">
    <button class="btn icon" id="panelToggleLeft" title="Menu">☰</button>
    <div class="brand">🎬 Video <span>Editor</span></div>
    <button class="btn" id="importBtn" title="Import media">＋<span class="lbl"> Import media</span></button>
    <input type="file" id="fileInput" accept="video/*,image/*,audio/*" multiple hidden>
    <button class="btn rec" id="recBtn" title="Record voice">🎙<span class="lbl"> Record voice</span></button>
    <button class="btn ai" id="openAiBtn" title="AI Studio">✨<span class="lbl"> AI Studio</span></button>
    <div class="spacer"></div>
    <div id="timeReadout">00:00.0 / 00:00.0</div>
    <button class="btn primary" id="exportBtn">⬇<span class="lbl"> Export</span></button>
    <button class="btn icon" id="panelToggleRight" title="Properties">⚙</button>
  </header>

  <div id="body">
    <aside id="left">
      <div class="panelTabs">
        <button class="tab active" data-tab="media">MEDIA</button>
        <button class="tab" data-tab="text">TEXT</button>
        <button class="tab" data-tab="draw">DRAW</button>
        <button class="tab" data-tab="fx">FX</button>
        <button class="tab" data-tab="trans">TRANS</button>
        <button class="tab aiTab" data-tab="ai">✨ AI</button>
      </div>

      <div class="tabPane" id="tab-media">
        <div id="dropzone">Drop video, image or audio files<br>or tap <b>Import media</b></div>
        <div id="mediaList"></div>
      </div>

      <div class="tabPane hidden" id="tab-text">
        <button class="presetBtn" data-preset="title">Title<small>Big centred headline</small></button>
        <button class="presetBtn" data-preset="subtitle">Subtitle<small>Smaller text near the bottom</small></button>
        <button class="presetBtn" data-preset="caption">Caption<small>Small text, lower third</small></button>
        <button class="presetBtn" data-preset="plain">Plain text<small>Just the basics</small></button>
      </div>

      <div class="tabPane hidden" id="tab-draw">
        <button class="actionBtn" id="newDrawingBtn">🎨 New drawing</button>
        <p class="muted" style="margin-top:0">Draw with mouse, pen, or finger. Saved drawings appear in MEDIA.</p>
      </div>

      <div class="tabPane hidden" id="tab-fx">
        <div class="fxSectionTitle">Kits (one-click looks)</div>
        <div id="kitsGrid"></div>
        <div class="fxSectionTitle" style="margin-top:16px">Individual effects</div>
        <div id="effectsGrid"></div>
      </div>

      <div class="tabPane hidden" id="tab-trans">
        <div class="fxSectionTitle">Transitions</div>
        <p class="muted" style="margin-top:0;font-size:11px;margin-bottom:10px">
          Applied to the <b>start</b> of the selected clip. The previous clip on the same track must touch this clip's start.
        </p>
        <div id="transGrid"></div>
        <div class="fxHint" style="margin-top:14px">
          <b>How to use:</b><br>
          1. Place two clips so one ends exactly when the next starts.<br>
          2. Select the second clip.<br>
          3. Click a transition above.<br>
          4. Adjust duration in Properties (right panel).
        </div>
        <div class="transitionSection" style="margin-top:16px">
          <h4>Apply to all</h4>
          <div style="display:flex;gap:6px">
            <select id="transAllSelect" style="flex:1;background:var(--panel2);
              border:1px solid var(--line);color:var(--text);border-radius:6px;
              padding:7px;font-size:12px;font-family:inherit"></select>
            <button class="btn sm" id="transAllApply" style="background:#f59e0b;
              border-color:#f59e0b;color:#fff">Apply</button>
          </div>
        </div>
      </div>

      <div class="tabPane hidden" id="tab-ai">
        <div class="aiHeader">
          <h3>✨ AI Studio</h3>
          <p>Type what you want. Smart Search pulls real info + photos.</p>
        </div>
        <textarea id="aiPrompt" placeholder="e.g. 'aurora borealis over Iceland' or 'red panda in a tree'"></textarea>
        <label class="smartToggle">
          <input type="checkbox" id="aiSmartSearch" checked>
          <span class="stLabel">🔍 Smart Search
            <span class="stSub">Search Wikipedia + Wikimedia for facts & photos</span>
          </span>
        </label>
        <div class="aiTypeGrid">
          <button class="aiTypeBtn active" data-ai="text"><span class="aiTypeIcon">📝</span>Text</button>
          <button class="aiTypeBtn" data-ai="image"><span class="aiTypeIcon">🖼</span>Image</button>
          <button class="aiTypeBtn" data-ai="video"><span class="aiTypeIcon">🎞</span>Video</button>
          <button class="aiTypeBtn" data-ai="draw"><span class="aiTypeIcon">✏️</span>Draw</button>
        </div>
        <div class="aiRow">
          <label>Mood</label>
          <select id="aiStyle">
            <option value="auto">Auto-detect</option>
            <option value="day">Bright day</option>
            <option value="sunset">Sunset</option>
            <option value="night">Night</option>
            <option value="storm">Stormy</option>
            <option value="snow">Snowy</option>
            <option value="space">Outer space</option>
          </select>
        </div>
        <div class="aiRow" id="aiDurRow" style="display:none">
          <label>Length</label>
          <select id="aiDuration">
            <option value="2">2s</option>
            <option value="3" selected>3s</option>
            <option value="5">5s</option>
            <option value="8">8s</option>
          </select>
        </div>
        <div class="aiBtnRow">
          <button class="aiSearchBtn" id="aiSearchBtn">🔍 Search</button>
          <button class="aiGenBtn" id="aiGenBtn">✨ Generate</button>
        </div>
        <div id="aiStatus">Ready.</div>
        <div id="aiProgress"><div id="aiProgressBar"></div></div>
        <div id="aiSearchPanel">
          <div class="srHead" id="srToggle">
            <span>🔍 SEARCH RESULTS</span>
            <span class="srCount" id="srCount">—</span>
          </div>
          <div class="srBody" id="srBody">
            <div class="srEmpty">No search yet — type a prompt and hit 🔍 Search, or press Generate.</div>
          </div>
        </div>
        <div class="aiExamples">
          <b>Try these:</b>
          <span class="aiExChip">aurora borealis over Iceland</span>
          <span class="aiExChip">red panda in a tree</span>
          <span class="aiExChip">tokyo at night</span>
          <span class="aiExChip">great barrier reef</span>
          <span class="aiExChip">sahara desert sunset</span>
          <span class="aiExChip">mount fuji</span>
          <span class="aiExChip">santorini greece</span>
          <span class="aiExChip">hawaii volcano</span>
          <span class="aiExChip">northern lights</span>
          <span class="aiExChip">grand canyon</span>
        </div>
        <details class="aiSettings">
          <summary>Use real AI APIs (optional)</summary>
          <div class="apiToggle">
            <input type="checkbox" id="aiUseApi">
            <label for="aiUseApi">Try real API first, fall back to local</label>
          </div>
          <div class="keyField">
            <label style="font-size:10px;color:var(--muted);font-weight:700;letter-spacing:.4px">OpenAI API key</label>
            <input type="password" id="apiKeyOpenAI" placeholder="sk-…" autocomplete="off">
            <small>Used for AI Text (gpt-4o-mini) and AI Image (dall-e-3).</small>
          </div>
        </details>
      </div>
    </aside>

    <section id="stage">
      <div id="previewWrap">
        <canvas id="preview" width="1280" height="720"></canvas>
      </div>
      <div id="transport">
        <button id="toStart" title="Go to start">⏮</button>
        <button id="playBtn" title="Play / Pause (Space)">▶</button>
        <button id="toEnd" title="Go to end">⏭</button>
        <span id="timecode">00:00.0</span>
      </div>
    </section>

    <aside id="right">
      <h3>Properties</h3>
      <div id="props"><p class="muted">Select a clip on the timeline to edit it.</p></div>
    </aside>
  </div>

  <footer id="timeline">
    <div id="tlToolbar">
      <button class="btn sm" id="splitBtn" title="Split at playhead (S)">✂ Split</button>
      <button class="btn sm" id="dupBtn" title="Duplicate (Ctrl+D)">⧉ Duplicate</button>
      <button class="btn sm" id="delBtn" title="Delete (Del)">🗑 Delete</button>
      <div class="spacer"></div>
      <button class="btn sm" id="zoomOut">−</button>
      <span id="zoomLabel">100%</span>
      <button class="btn sm" id="zoomIn">＋</button>
    </div>
    <div id="tlBody">
      <div id="trackLabels">
        <div class="trackLabel" style="height:64px">Video</div>
        <div class="trackLabel" style="height:44px">Text</div>
        <div class="trackLabel" style="height:44px">Audio</div>
      </div>
      <div id="lanesScroll">
        <div id="lanes">
          <div id="ruler"></div>
          <div id="tracks">
            <div class="lane" data-track="0" style="height:64px"></div>
            <div class="lane" data-track="1" style="height:44px"></div>
            <div class="lane" data-track="2" style="height:44px"></div>
            <div id="playhead"></div>
          </div>
        </div>
      </div>
    </div>
  </footer>
</div>

<div id="drawerBackdrop"></div>

<div class="modal hidden" id="drawModal">
  <div class="modalContent">
    <div class="modalHeader">
      <h2>🎨 Drawing</h2>
      <button id="closeDraw" title="Close">×</button>
    </div>
    <canvas id="drawCanvas" width="1280" height="720"></canvas>
    <div class="drawToolbar">
      <label>Colour</label>
      <input type="color" id="brushColor" value="#ff3b6b">
      <label>Size</label>
      <input type="range" id="brushSize" min="1" max="80" value="8">
      <div class="brushPreview"><span id="brushPreviewDot" style="width:8px;height:8px"></span></div>
      <button id="eraserBtn">🧽 Eraser</button>
      <button id="undoDraw">↶ Undo</button>
      <button id="clearDraw">🗑 Clear</button>
      <div class="spacer" style="flex:1"></div>
      <button class="primary" id="saveDraw">✓ Save</button>
    </div>
  </div>
</div>

<div class="modal hidden" id="exportModal">
  <div class="modalContent">
    <div class="modalHeader">
      <h2>⬇ Export video</h2>
      <button id="closeExport" title="Close">×</button>
    </div>
    <div id="exportChoices">
      <div class="fmtOption selected" data-fmt="mp4">
        <div class="fmtIcon">🎬</div>
        <div class="fmtInfo">
          <div class="fmtName">MP4 <span class="fmtBadge universal">WORKS EVERYWHERE</span></div>
          <div class="fmtDesc">Plays on iPhone, Android, Windows Media Player, QuickTime, TVs, and every social platform. Takes 1–2× longer since it re-encodes in your browser.</div>
        </div>
      </div>
      <div class="fmtOption" data-fmt="webm">
        <div class="fmtIcon">⚡</div>
        <div class="fmtInfo">
          <div class="fmtName">WebM <span class="fmtBadge fast">FAST</span></div>
          <div class="fmtDesc">Instant export. Plays in VLC, Chrome, Edge, Firefox, Windows Movies & TV. May not open on iPhone or in QuickTime.</div>
        </div>
      </div>
      <button class="actionBtn" id="startExport" style="margin-top:6px;margin-bottom:0">⬇ Export now</button>
    </div>
    <div id="exportProgress">
      <div class="epStep" id="epStep1"><span>🎥 Recording timeline</span><span id="epStep1Pct">0%</span></div>
      <div class="epBar"><div class="epBarFill" id="epBar1"></div></div>
      <div class="epStep" id="epStep2" style="display:none"><span>⚙️ Loading MP4 encoder (first time only)</span><span id="epStep2Pct"></span></div>
      <div class="epBar" id="epBar2Wrap" style="display:none"><div class="epBarFill" id="epBar2"></div></div>
      <div class="epStep" id="epStep3" style="display:none"><span>🔁 Converting to MP4</span><span id="epStep3Pct">0%</span></div>
      <div class="epBar" id="epBar3Wrap" style="display:none"><div class="epBarFill" id="epBar3"></div></div>
      <p class="muted" style="font-size:11px;margin-top:12px;line-height:1.5" id="epHint">
        Keep this tab open — the export runs in your browser.
      </p>
    </div>
  </div>
</div>

<div class="modal hidden" id="resultModal">
  <div class="modalContent" style="width:min(94vw,640px)">
    <div class="modalHeader">
      <h2 id="resultTitle">✅ Export ready</h2>
      <button id="closeResult" title="Close">×</button>
    </div>
    <video id="resultVideo" controls playsinline
      style="width:100%;border-radius:8px;background:#000;max-height:60vh"></video>
    <p class="muted" id="resultInfo" style="font-size:12px;margin:10px 0;line-height:1.5"></p>
    <div style="display:flex;gap:8px">
