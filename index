   17. SMART SEARCH
   ========================================================= */
const STOP_WORDS = new Set(['the','a','an','and','or','of','to','in','on','for','with',
  'is','are','was','were','be','been','being','by','as','at','from','that','this',
  'it','its','which','who','whom','what','where','when','why','how','also','into',
  'has','have','had','can','could','would','should','may','might','will','than',
  'then','there','their','they','them','these','those','some','any','all','other',
  'such','only','own','same','too','very','just','but','not','no','nor']);

async function smartSearch(query){
  const result = { title: query, summary: '', url: null, keywords: [], related: [], images: [] };
  if (!query || query.trim().length < 2) return result;
  let bestTitle = null;
  try {
    const url = 'https://en.wikipedia.org/w/api.php?' + new URLSearchParams({
      action: 'query', list: 'search', srsearch: query,
      format: 'json', origin: '*', srlimit: 6
    });
    const r = await fetch(url);
    const data = await r.json();
    const hits = (data.query && data.query.search) || [];
    if (hits.length){
      result.related = hits.map(h => h.title);
      bestTitle = hits[0].title;
      result.title = bestTitle;
    }
  } catch(e){ console.warn('search step1', e); }
  if (bestTitle){
    try {
      const r = await fetch('https://en.wikipedia.org/api/rest_v1/page/summary/' +
        encodeURIComponent(bestTitle));
      if (r.ok){
        const data = await r.json();
        result.summary = data.extract || '';
        result.url = data.content_urls?.desktop?.page || null;
      }
    } catch(e){ console.warn('search step2', e); }
  }
  const text = (result.title + ' ' + result.summary + ' ' + query).toLowerCase();
  const words = text.match(/[a-z][a-z\-']{3,}/g) || [];
  const freq = {};
  words.forEach(w => { if (!STOP_WORDS.has(w)) freq[w] = (freq[w] || 0) + 1; });
  result.keywords = Object.entries(freq)
    .sort((a, b) => b[1] - a[1]).slice(0, 14).map(x => x[0]);
  try {
    const url = 'https://commons.wikimedia.org/w/api.php?' + new URLSearchParams({
      action: 'query', generator: 'search',
      gsrsearch: (query + ' filetype:bitmap').slice(0, 200),
      gsrnamespace: '6', gsrlimit: '12',
      prop: 'imageinfo', iiprop: 'url|extmetadata',
      iiurlwidth: '280', format: 'json', origin: '*'
    });
    const r = await fetch(url);
    const data = await r.json();
    const pages = data.query?.pages || {};
    const list = Object.values(pages);
    for (const p of list){
      const info = p.imageinfo && p.imageinfo[0];
      if (!info) continue;
      const thumb = info.thumburl || info.url;
      if (!thumb) continue;
      if (!/\.(jpe?g|png|gif|webp)$/i.test(info.url || '')) continue;
      result.images.push({
        thumb, url: info.url,
        title: p.title.replace(/^File:/, '').replace(/\.\w+$/, '')
      });
      if (result.images.length >= 9) break;
    }
  } catch(e){ console.warn('search step3', e); }
  return result;
}

function renderSearchPanel(data){
  const panel = $('#aiSearchPanel');
  const body = $('#srBody');
  const count = $('#srCount');
  if (!data || (!data.title && !data.images.length)){
    panel.classList.add('show');
