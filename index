}
$('#panelToggleLeft').onclick = () => openDrawer('left');
$('#panelToggleRight').onclick = () => openDrawer('right');
backdrop.onclick = closeDrawers;
let lastNarrow = isNarrow();
window.addEventListener('resize', () => {
