function drawMountains(cx, W, H, baseY, color, seed, peaks){
  cx.fillStyle = color;
  cx.beginPath(); cx.moveTo(0, H);
  const step = W / peaks;
  let prevY = baseY;
  for (let i = 0; i <= peaks; i++){
    const x = i * step;
    const y = baseY - (hash(seed + i) * 0.4 + 0.6) * (baseY * 0.55);
    if (i === 0) cx.lineTo(x, y);
    else {
      const midX = x - step / 2;
      const midY = Math.max(y, prevY) - 30;
      cx.lineTo(midX, midY); cx.lineTo(x, y);
    }
    prevY = y;
  }
  cx.lineTo(W, H); cx.closePath(); cx.fill();
}
function drawOcean(cx, W, H, horizonY, t, night){
  const g = cx.createLinearGradient(0, horizonY, 0, H);
  if (night){ g.addColorStop(0, '#0a1530'); g.addColorStop(1, '#1a2844'); }
  else { g.addColorStop(0, '#2a7aaa'); g.addColorStop(1, '#0a3a5a'); }
  cx.fillStyle = g; cx.fillRect(0, horizonY, W, H - horizonY);
  cx.strokeStyle = 'rgba(255,255,255,0.22)';
  for (let layer = 0; layer < 7; layer++){
    const yBase = horizonY + 20 + layer * ((H - horizonY) / 7);
    const amp = 4 + layer * 2.2;
    cx.beginPath();
    for (let x = 0; x <= W; x += 8){
      const y = yBase + Math.sin(x * 0.02 + t * 1.5 + layer) * amp
                       + Math.sin(x * 0.05 + t * 2) * amp * 0.35;
      if (x === 0) cx.moveTo(x, y); else cx.lineTo(x, y);
    }
    cx.lineWidth = 1 + layer * 0.3; cx.stroke();
  }
  if (!night){
    const rg = cx.createLinearGradient(W/2, horizonY, W/2, H);
    rg.addColorStop(0, 'rgba(255,220,150,0.55)');
    rg.addColorStop(1, 'rgba(255,220,150,0)');
    cx.fillStyle = rg;
    for (let y = horizonY; y < H; y += 4){
      const wig = Math.sin(y * 0.1 + t * 2) * 20;
      cx.fillRect(W/2 - 30 + wig, y, 60, 3);
    }
  }
}
function drawGround(cx, W, H, groundY, kind, t){
  let top, bot;
  if (kind === 'sand'){ top = '#e8c890'; bot = '#a8854a'; }
  else if (kind === 'snow'){ top = '#eaf0f8'; bot = '#c8d4e2'; }
  else if (kind === 'lava'){ top = '#3a1a0a'; bot = '#1a0808'; }
  else { top = '#4a8a3a'; bot = '#2a5a1a'; }
  const g = cx.createLinearGradient(0, groundY, 0, H);
  g.addColorStop(0, top); g.addColorStop(1, bot);
  cx.fillStyle = g; cx.fillRect(0, groundY, W, H - groundY);
  if (kind === 'grass'){
    cx.strokeStyle = 'rgba(120,200,90,0.55)'; cx.lineWidth = 1;
    for (let i = 0; i < 250; i++){
      const x = hash(i * 3.3) * W;
      const y = groundY + hash(i * 5.7) * (H - groundY);
      const h = 3 + hash(i * 7.1) * 7;
      cx.beginPath(); cx.moveTo(x, y);
      cx.lineTo(x + Math.sin(t + i) * 2, y - h); cx.stroke();
    }
  }
}
function drawTree(cx, x, groundY, h, color){
