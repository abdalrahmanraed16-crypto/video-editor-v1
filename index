}, {passive:true});
rightPanel.addEventListener('touchend', e => {
  if (!isNarrow()) return;
  if (e.changedTouches[0].clientX - rightPanel._startX > 60) closeDrawers();
}, {passive:true});

/* =========================================================
   2. Media handling
   ========================================================= */
function addFiles(files){
  [...files].forEach(file => {
    let type = null;
    if (file.type.startsWith('video')) type = 'video';
    else if (file.type.startsWith('audio')) type = 'audio';
    else if (file.type.startsWith('image')) type = 'image';
    if (!type) return;
    const url = URL.createObjectURL(file);
    const el = document.createElement(type === 'image' ? 'img' : type);
    el.src = url;
    if (type !== 'image'){ el.preload = 'auto'; el.playsInline = true; el.setAttribute('playsinline',''); }
    if (type === 'audio') el.style.display = 'none';
    const item = { id: uid(), name: file.name, type, url, el,
      duration: type === 'image' ? 5 : 0, w: 1280, h: 720, thumb: null, ready: false };
    const finish = () => {
      if (type === 'image'){ item.w = el.naturalWidth || 1280; item.h = el.naturalHeight || 720; item.duration = 5; }
      else {
        item.duration = isFinite(el.duration) && el.duration > 0 ? el.duration : 5;
        item.w = el.videoWidth || 1280; item.h = el.videoHeight || 720;
      }
      item.ready = true; buildThumb(item); renderMediaList();
    };
    if (type === 'image'){
      if (el.complete && el.naturalWidth) finish(); else el.onload = finish;
      el.onerror = finish;
    } else {
      el.onloadedmetadata = finish;
      el.onerror = () => { item.ready = true; renderMediaList(); };
    }
    state.media.push(item);
  });
  renderMediaList();
}
function addMediaItem(item){ state.media.push(item); renderMediaList(); }
function buildThumb(item){
  try{
    const c = document.createElement('canvas');
    c.width = 128; c.height = 72;
    const cx = c.getContext('2d');
    if (item.type === 'audio'){ item.thumb = null; renderMediaList(); return; }
    const grab = () => {
      try { cx.drawImage(item.el, 0, 0, 128, 72); item.thumb = c.toDataURL('image/jpeg', 0.6); }
      catch(e){}
      renderMediaList();
    };
    if (item.type === 'image') grab();
    else {
      const v = item.el;
      const onSeek = () => { v.removeEventListener('seeked', onSeek); grab(); };
      v.addEventListener('seeked', onSeek);
      try { v.currentTime = Math.min(0.4, (v.duration || 1) / 2); } catch(e){ grab(); }
      setTimeout(grab, 1200);
    }
  } catch(e){}
}
function renderMediaList(){
  const list = $('#mediaList');
  if (!state.media.length){ list.innerHTML = ''; return; }
  list.innerHTML = state.media.map(m => `
    <div class="mediaItem ${m.ai ? 'ai' : ''} ${m.search ? 'search' : ''}" data-id="${m.id}" title="Tap to add to timeline">
      <div class="thumb" ${m.thumb ? `style="background-image:url(${m.thumb})"` : ''}>
        ${m.thumb ? '' : (m.type === 'audio' ? '🎵' : m.type === 'image' ? '🖼' : '🎞')}
      </div>
      <div class="meta">
        <div class="name">${esc(m.name)}</div>
        <div class="dur">${m.type === 'image' ? 'still' : fmtShort(m.duration)}</div>
      </div>
    </div>`).join('');
}
function getMedia(c){ return c.mediaId ? state.media.find(m => m.id === c.mediaId) : null; }

/* =========================================================
   3. Timeline helpers
   ========================================================= */
function totalDuration(){ return state.clips.reduce((m, c) => Math.max(m, c.start + c.dur), 0); }
function findFreeStart(track, desired, dur){
  let t = Math.max(0, desired);
  const list = state.clips.filter(c => c.track === track).sort((a,b) => a.start - b.start);
  let moved = true, guard = 0;
  while (moved && guard++ < 200){
    moved = false;
    for (const c of list){
      if (t < c.start + c.dur && t + dur > c.start){ t = c.start + c.dur; moved = true; }
    }
  }
  return t;
}
function getPrevAdjacentClip(c){
  let best = null, bestGap = Infinity;
  for (const x of state.clips){
    if (x.id === c.id) continue;
    if (x.track !== c.track) continue;
    const gap = Math.abs((x.start + x.dur) - c.start);
    if (gap < 0.08 && gap < bestGap){ best = x; bestGap = gap; }
  }
  return best;
}
function addMediaClip(mediaId){
  const m = state.media.find(x => x.id === mediaId);
  if (!m) return;
  const track = m.type === 'audio' ? 2 : 0;
  const dur = m.type === 'image' ? 5 : (m.duration || 5);
  const start = findFreeStart(track, state.playhead, dur);
  const clip = { id: uid(), kind: 'media', mediaId, track, start, dur,
    in: 0, volume: 1, opacity: 1, fadeIn: 0, fadeOut: 0, effects: [],
    transIn: { type:'none', dur: 0.5 },
    isAI: !!m.ai, isSearch: !!m.search };
  state.clips.push(clip); select(clip.id); renderTimeline();
  if (isPhone()) closeDrawers();
}
function addTextClip(preset, customText){
  const cfg = {
    title: { text:'Your Title Here', fontSize:96, x:50, y:42, color:'#ffffff' },
    subtitle: { text:'A subtitle line', fontSize:52, x:50, y:78, color:'#ffffff' },
    caption: { text:'Caption text', fontSize:38, x:50, y:86, color:'#ffffff' },
    plain: { text:'Text', fontSize:64, x:50, y:50, color:'#ffffff' }
  }[preset] || { text:'Text', fontSize:64, x:50, y:50, color:'#ffffff' };
  if (customText) cfg.text = customText;
  const dur = 4;
  const start = findFreeStart(1, state.playhead, dur);
  const clip = { id: uid(), kind: 'text', track: 1, start, dur,
    text: cfg.text, fontSize: cfg.fontSize, color: cfg.color,
    x: cfg.x, y: cfg.y, align: 'center', fadeIn: 0.3, fadeOut: 0.3,
    effects: [], transIn: { type:'none', dur: 0.5 } };
  state.clips.push(clip); select(clip.id); renderTimeline();
}
function select(id){ state.sel = id; renderTimeline(); renderProps(); renderFxGrid(); renderTransGrid(); }

/* =========================================================
   4. Timeline rendering
   ========================================================= */
function layoutClip(el, c){
  el.style.left = (c.start * state.pps) + 'px';
  el.style.width = Math.max(12, c.dur * state.pps) + 'px';
}
function renderTimeline(){
  laneEls.forEach(l => l.innerHTML = '');
  state.clips.forEach(c => {
    const lane = laneEls[c.track]; if (!lane) return;
    const el = document.createElement('div');
    el.className = 'clip' + (c.kind === 'text' ? ' text' : '') +
      (c.track === 2 ? ' audio' : '') + (c.isAI ? ' ai' : '') +
      (c.isSearch ? ' search' : '') + (state.sel === c.id ? ' selected' : '');
    el.dataset.id = c.id; layoutClip(el, c);
    let label = '';
    if (c.kind === 'media'){
      const m = getMedia(c);
      if (m && m.thumb) el.style.backgroundImage = `linear-gradient(rgba(0,0,0,.42),rgba(0,0,0,.42)), url(${m.thumb})`;
      label = esc(m ? m.name : 'clip');
    } else label = 'T · ' + esc((c.text || '').slice(0, 26));
    const fxCount = (c.effects || []).length;
    let badge = '';
    if (c.isAI) badge = '<span class="aiBadge">✨ AI</span>';
    else if (c.isSearch) badge = '<span class="searchBadge">🔍 WEB</span>';
    const transType = c.transIn?.type;
    const hasTrans = transType && transType !== 'none';
    const transIcon = hasTrans ? (TRANS_LOOKUP[transType]?.icon || '✨') : '';
    el.innerHTML = `<div class="handle left"></div>
      ${hasTrans ? `<div class="transIndicator" title="Transition: ${TRANS_LOOKUP[transType]?.label || transType}">${transIcon}</div>` : ''}
      ${badge}
      ${fxCount ? `<span class="fxBadge">FX ${fxCount}</span>` : ''}
      <span class="clipLabel">${label}</span>
      <div class="handle right"></div>`;
    lane.appendChild(el);
  });
  updateRuler(); updateLanesWidth(); updatePlayheadUI(); updateTimeUI();
}
function updateLanesWidth(){
  const total = Math.max(totalDuration(), 12) + 6;
  lanesEl.style.width = (total * state.pps + 160) + 'px';
}
function updateRuler(){
  const total = Math.max(totalDuration(), 12) + 6;
  let step = 1;
  if (state.pps < 14) step = 10; else if (state.pps < 28) step = 5; else if (state.pps < 55) step = 2;
  let html = '';
  for (let t = 0; t <= total; t += step)
    html += `<div class="tick" style="left:${t * state.pps}px"><span>${fmtShort(t)}</span></div>`;
  rulerEl.innerHTML = html;
}
function updatePlayheadUI(){ playheadEl.style.left = (state.playhead * state.pps) + 'px'; }
function updateTimeUI(){
  $('#timecode').textContent = fmt(state.playhead);
  $('#timeReadout').textContent = `${fmt(state.playhead)} / ${fmt(totalDuration())}`;
}

/* =========================================================
   5. Scrubbing / dragging / trimming
   ========================================================= */
let drag = null;
function timeFromX(clientX){
  const rect = lanesEl.getBoundingClientRect();
  return Math.max(0, (clientX - rect.left) / state.pps);
}
function setPlayhead(t){ state.playhead = Math.max(0, t); updatePlayheadUI(); updateTimeUI(); }
function snapTime(t, exclude){
  const tol = 9 / state.pps;
  const targets = [0, state.playhead];
  state.clips.forEach(c => { if (c === exclude) return; targets.push(c.start, c.start + c.dur); });
  for (const tg of targets) if (Math.abs(t - tg) < tol) return tg;
  return t;
}
document.addEventListener('pointerdown', e => {
  if (state.exporting) return;
  if (e.target.closest('.modal')) return;
  const clipEl = e.target.closest('.clip');
  if (clipEl){
    const c = state.clips.find(x => x.id === clipEl.dataset.id);
    if (!c) return;
    select(c.id);
    let mode = 'move';
    if (e.target.classList.contains('handle'))
      mode = e.target.classList.contains('left') ? 'trimL' : 'trimR';
    drag = { mode, c, el: clipEl, startX: e.clientX,
      origStart: c.start, origDur: c.dur, origIn: c.in || 0 };
    document.body.style.userSelect = 'none';
    e.preventDefault(); return;
  }
  if (e.target.closest('#tracks') || e.target.closest('#ruler')){
    if (e.target.closest('#tracks') && !e.target.closest('.clip')) select(null);
    setPlayhead(timeFromX(e.clientX));
    drag = { mode: 'scrub' };
    document.body.style.userSelect = 'none';
    e.preventDefault();
  }
});
document.addEventListener('pointermove', e => {
  if (!drag) return;
  if (drag.mode === 'scrub'){ setPlayhead(timeFromX(e.clientX)); return; }
  const dx = (e.clientX - drag.startX) / state.pps;
  const c = drag.c;
  if (drag.mode === 'move'){
    c.start = Math.max(0, snapTime(drag.origStart + dx, c));
  } else if (drag.mode === 'trimR'){
    let nd = Math.max(0.1, drag.origDur + dx);
    if (c.kind === 'media'){
      const m = getMedia(c);
      if (m && m.type !== 'image') nd = Math.min(nd, Math.max(0.1, m.duration - (c.in || 0)));
    }
    c.dur = nd;
  } else if (drag.mode === 'trimL'){
    const minStart = c.kind === 'media' ? Math.max(0, drag.origStart - drag.origIn) : 0;
    const ns = clamp(drag.origStart + dx, minStart, drag.origStart + drag.origDur - 0.1);
    const delta = ns - drag.origStart;
    c.start = ns; c.dur = drag.origDur - delta;
    if (c.kind === 'media') c.in = Math.max(0, drag.origIn + delta);
  }
  layoutClip(drag.el, c); updateTimeUI();
});
document.addEventListener('pointerup', () => {
  if (!drag) return;
  const wasDrag = drag.mode !== 'scrub';
  drag = null; document.body.style.userSelect = '';
  if (wasDrag){ renderTimeline(); renderProps(); }
});

/* =========================================================
   6. Clip ops
   ========================================================= */
function splitSelected(){
  const c = state.clips.find(x => x.id === state.sel); if (!c) return;
  const t = state.playhead;
  if (t <= c.start + 0.05 || t >= c.start + c.dur - 0.05) return;
  const right = Object.assign({}, c, { id: uid(), start: t, dur: c.start + c.dur - t,
    effects: (c.effects || []).map(e => ({ ...e })),
    transIn: c.transIn ? { ...c.transIn } : { type:'none', dur: 0.5 } });
  if (c.kind === 'media') right.in = (c.in || 0) + (t - c.start);
  c.dur = t - c.start;
  state.clips.push(right); select(right.id);
}
function deleteSelected(){
  if (!state.sel) return;
  state.clips = state.clips.filter(c => c.id !== state.sel);
  state.sel = null; renderTimeline(); renderProps(); renderFxGrid(); renderTransGrid();
}
function duplicateSelected(){
  const c = state.clips.find(x => x.id === state.sel); if (!c) return;
  const copy = Object.assign({}, c, { id: uid(), start: c.start + c.dur,
    effects: (c.effects || []).map(e => ({ ...e })),
    transIn: c.transIn ? { ...c.transIn } : { type:'none', dur: 0.5 } });
  state.clips.push(copy); select(copy.id);
}

/* =========================================================
   7. FX
   ========================================================= */
function isFxCapable(c){ return c.kind === 'media' || c.kind === 'text'; }
function addEffectToSelected(type){
  const c = state.clips.find(x => x.id === state.sel);
  if (!c){ toast('Select a clip on the timeline first.'); return; }
  if (!isFxCapable(c)){ toast('Effects work on video, image, drawing and text clips.'); return; }
  if (!c.effects) c.effects = [];
  if (c.effects.find(e => e.type === type)) c.effects = c.effects.filter(e => e.type !== type);
  else {
    const def = EFFECT_LOOKUP[type] || { type, intensity:0.6 };
    c.effects.push({ type, intensity: def.intensity ?? 0.6 });
  }
  renderTimeline(); renderProps(); renderFxGrid();
}
function applyKitToSelected(key){
  const c = state.clips.find(x => x.id === state.sel);
  if (!c){ toast('Select a clip on the timeline first.'); return; }
  if (!isFxCapable(c)){ toast('Kits work on video, image, drawing and text clips.'); return; }
  const kit = KITS[key]; if (!kit) return;
  c.effects = kit.effects.map(e => ({ ...e }));
  renderTimeline(); renderProps(); renderFxGrid();
}
function applyTransitionToSelected(type){
  const c = state.clips.find(x => x.id === state.sel);
  if (!c){ toast('Select a clip first.'); return; }
  if (!isFxCapable(c)){ toast('Transitions work on video/image/text clips.'); return; }
  if (!c.transIn) c.transIn = { type:'none', dur: 0.5 };
  c.transIn.type = type;
  if (type === 'none'){ /* just clear */ }
  else if (!c.transIn.dur || c.transIn.dur < 0.1) c.transIn.dur = 0.5;
  renderTimeline(); renderProps(); renderTransGrid();
  if (type !== 'none'){
    const prev = getPrevAdjacentClip(c);
    if (!prev) toast('No adjacent clip before this one — transition will show once clips touch.');
  }
}
function applyTransitionToAll(type){
  let count = 0;
  for (const c of state.clips){
    if (!isFxCapable(c)) continue;
    const prev = getPrevAdjacentClip(c);
    if (!prev) continue;
    if (!c.transIn) c.transIn = { type:'none', dur: 0.5 };
    c.transIn.type = type;
    count++;
  }
  renderTimeline(); renderProps(); renderTransGrid();
  toast(count ? `Applied to ${count} clip${count>1?'s':''}.` : 'No adjacent clip pairs found.');
}
let toastTimer = null;
