let micRecorder = null, micChunks = [], micStream = null;
async function toggleVoiceRecording(){
  if (micRecorder && micRecorder.state === 'recording'){ micRecorder.stop(); return; }
  if (!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia){
    alert('Microphone not supported in this browser.'); return;
  }
  try { micStream = await navigator.mediaDevices.getUserMedia({ audio: true }); }
  catch(err){ alert('Could not access microphone: ' + (err.message || err)); return; }
  const candidates = ['audio/webm;codecs=opus','audio/webm','audio/ogg;codecs=opus'];
  const mimeType = candidates.find(t => MediaRecorder.isTypeSupported(t)) || '';
  try { micRecorder = new MediaRecorder(micStream, { mimeType }); }
  catch(err){
    alert('Could not start recorder: ' + err.message);
    micStream.getTracks().forEach(t => t.stop()); micStream = null; return;
  }
  micChunks = [];
  micRecorder.ondataavailable = e => { if (e.data && e.data.size) micChunks.push(e.data); };
  micRecorder.onstop = () => {
    const blob = new Blob(micChunks, { type: mimeType || 'audio/webm' });
    const url = URL.createObjectURL(blob);
    const el = document.createElement('audio');
    el.src = url; el.preload = 'auto'; el.style.display = 'none';
    const item = { id: uid(),
      name: '🎙 Voice ' + new Date().toLocaleTimeString([], {hour:'2-digit', minute:'2-digit', second:'2-digit'}),
      type: 'audio', url, el, duration: 0, w: 0, h: 0, thumb: null, ready: false };
    el.onloadedmetadata = () => {
      item.duration = isFinite(el.duration) && el.duration > 0 ? el.duration : 5;
      item.ready = true; renderMediaList();
    };
    addMediaItem(item); toast('Voice recording saved to media');
    if (micStream){ micStream.getTracks().forEach(t => t.stop()); micStream = null; }
    micRecorder = null; updateRecUI();
  };
  micRecorder.start(); updateRecUI();
  toast('Recording… tap the mic again to stop');
}
function updateRecUI(){
  const btn = $('#recBtn');
  const recording = micRecorder && micRecorder.state === 'recording';
  btn.classList.toggle('recording', recording);
  btn.innerHTML = recording ? '⏹<span class="lbl"> Stop</span>' : '🎙<span class="lbl"> Record voice</span>';
}

