let ffmpegInstance = null;
let ffmpegLoading = false;
async function loadFFmpeg(onProgress){
  if (ffmpegInstance && ffmpegInstance.loaded) return ffmpegInstance;
  if (ffmpegLoading){
    while (ffmpegLoading) await new Promise(r => setTimeout(r, 100));
    return ffmpegInstance;
  }
  ffmpegLoading = true;
  try{
    if (!window.FFmpegLib){
      await new Promise((resolve, reject) => {
        const s = document.createElement('script');
        s.src = 'https://unpkg.com/@ffmpeg/ffmpeg@0.11.6/dist/ffmpeg.min.js';
        s.onload = resolve;
        s.onerror = () => reject(new Error('Failed to load ffmpeg library'));
        document.head.appendChild(s);
      });
      window.FFmpegLib = window.FFmpeg;
    }
    const { createFFmpeg } = window.FFmpegLib;
    const ffmpeg = createFFmpeg({
      log: false,
      corePath: 'https://unpkg.com/@ffmpeg/core@0.11.0/dist/ffmpeg-core.js',
      progress: ({ ratio }) => {
        if (ratio >= 0 && ratio <= 1 && onProgress) onProgress(Math.round(ratio * 100));
      }
    });
    onProgress && onProgress(5);
    await ffmpeg.load();
    ffmpeg.loaded = true;
    ffmpegInstance = ffmpeg;
    return ffmpeg;
  } finally {
    ffmpegLoading = false;
  }
}

async function exportVideoMP4(){
  if (state.exporting) return;
  state.exporting = true;
  const btn = $('#exportBtn');
  btn.disabled = true;
  $('#epStep1').className = 'epStep active';
  $('#epStep1Pct').textContent = '0%';
  $('#epBar1').style.width = '0%';
  $('#epStep2').style.display = 'none';
  $('#epBar2Wrap').style.display = 'none';
  $('#epStep3').style.display = 'none';
  $('#epBar3Wrap').style.display = 'none';
  $('#epHint').textContent = 'Step 1 of 3: recording your timeline…';
  try{
    const webmBlob = await recordTimeline(pct => {
      $('#epStep1Pct').textContent = pct + '%';
      $('#epBar1').style.width = pct + '%';
    });
    if (masterGain) masterGain.gain.value = 1;
    $('#epStep1').className = 'epStep done';
