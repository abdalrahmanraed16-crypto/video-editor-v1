    };
  });
  $$('.srRelatedChip').forEach(chip => {
    chip.onclick = () => { $('#aiPrompt').value = chip.dataset.title; $('#aiPrompt').focus(); };
  });
}

async function importWikimediaImage(img){
  try {
    setAiStatus(`Importing "${img.title}"…`, 'search');
    let url = img.url;
    let blob = null;
    try {
      const r = await fetch(url, { mode: 'cors' });
      if (r.ok) blob = await r.blob();
    } catch(e){}
    const el = new Image();
    el.crossOrigin = 'anonymous';
    if (blob) url = URL.createObjectURL(blob);
    el.src = url;
    await new Promise(res => {
      el.onload = () => res();
      el.onerror = () => res();
      setTimeout(res, 3000);
    });
    const c = document.createElement('canvas');
    c.width = 128; c.height = 72;
    const cx = c.getContext('2d');
    let thumb = img.thumb;
    try { cx.drawImage(el, 0, 0, 128, 72); thumb = c.toDataURL('image/jpeg', 0.6); }
    catch(e){}
    const item = {
      id: uid(), name: '🔍 ' + img.title.slice(0, 30),
      type: 'image', url, el, duration: 5,
      w: el.naturalWidth || 1024, h: el.naturalHeight || 720,
      thumb, ready: true, search: true
    };
    addMediaItem(item);
    setAiStatus(`✓ Imported "${img.title}"`, 'ok');
    switchTab('media');
    if (isPhone()) closeDrawers();
  } catch(err){
    setAiStatus('⚠ Could not import image: ' + (err.message || err), 'err');
  }
}

