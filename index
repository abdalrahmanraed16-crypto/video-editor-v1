    $('#epStep2').style.display = 'flex';
    $('#epBar2Wrap').style.display = 'block';
    $('#epStep2').className = 'epStep active';
    $('#epHint').textContent = 'Step 2 of 3: loading MP4 encoder (first time only — ~30 MB)…';
    await loadFFmpeg(pct => {
      $('#epStep2Pct').textContent = pct + '%';
      $('#epBar2').style.width = Math.min(100, pct * 2) + '%';
    });
    $('#epStep2').className = 'epStep done';
    $('#epBar2').style.width = '100%';
    $('#epStep2Pct').textContent = '100%';
    $('#epStep3').style.display = 'flex';
    $('#epBar3Wrap').style.display = 'block';
    $('#epStep3').className = 'epStep active';
    $('#epHint').textContent = 'Step 3 of 3: converting to MP4…';
    const ffmpeg = ffmpegInstance;
    const { fetchFile } = window.FFmpegLib;
    const inName = 'input.webm';
    const outName = 'output.mp4';
    ffmpeg.FS('writeFile', inName, await fetchFile(webmBlob));
    await ffmpeg.run(
      '-i', inName,
      '-c:v', 'libx264',
      '-preset', 'ultrafast',
      '-crf', '23',
      '-pix_fmt', 'yuv420p',
      '-c:a', 'aac',
      '-b:a', '128k',
      '-movflags', '+faststart',
      outName
    );
    $('#epBar3').style.width = '100%';
    $('#epStep3Pct').textContent = '100%';
    $('#epStep3').className = 'epStep done';
    const data = ffmpeg.FS('readFile', outName);
    const mp4Blob = new Blob([data.buffer], { type: 'video/mp4' });
    try { ffmpeg.FS('unlink', inName); } catch(e){}
    try { ffmpeg.FS('unlink', outName); } catch(e){}
    $('#epHint').textContent = 'Done!';
    $('#exportModal').classList.add('hidden');
    showResult(mp4Blob, 'mp4');
  } catch(err){
    console.error('MP4 export failed:', err);
    if (masterGain) masterGain.gain.value = 1;
    alert('MP4 export failed: ' + (err.message || err) +
          '\n\nTip: this needs an internet connection the first time to download the encoder. ' +
          'If it keeps failing, use WebM instead.');
    $('#exportModal').classList.add('hidden');
  } finally {
    state.exporting = false;
    btn.disabled = false;
  }
}

