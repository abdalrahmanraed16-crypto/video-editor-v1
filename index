async function recordTimeline(onProgress){
  return new Promise(async (resolve, reject) => {
    const dur = totalDuration();
    if (dur < 0.2){ reject(new Error('Timeline is empty.')); return; }
    ensureAudio(); setPlaying(false); setPlayhead(0);
    state.clips.forEach(c => {
      if (c.kind !== 'media') return;
      const m = getMedia(c);
      if (!m || m.type === 'image') return;
      try { m.el.currentTime = c.in || 0; } catch(e){}
    });
    await new Promise(r => setTimeout(r, 500));
    const canvasStream = canvas.captureStream(30);
    const videoTracks = canvasStream.getVideoTracks();
    const hasAudio = state.clips.some(c => {
      if (c.kind !== 'media') return false;
      const m = getMedia(c);
      return m && (m.type === 'video' || m.type === 'audio');
    });
    const tracks = [...videoTracks];
    if (hasAudio && streamDest && streamDest.stream.getAudioTracks().length){
      tracks.push(...streamDest.stream.getAudioTracks());
    }
    const outStream = new MediaStream(tracks);
    const candidates = [
      'video/webm;codecs=vp8,opus',
      'video/webm;codecs=vp8',
      'video/webm;codecs=vp9,opus',
      'video/webm'
    ];
    const mimeType = candidates.find(t => MediaRecorder.isTypeSupported(t)) || '';
    let rec;
    try{
      rec = new MediaRecorder(outStream, { mimeType,
        videoBitsPerSecond: 6_000_000, audioBitsPerSecond: 128_000 });
    } catch(e){ reject(e); return; }
    const chunks = [];
    rec.ondataavailable = e => { if (e.data && e.data.size) chunks.push(e.data); };
    rec.onstop = () => {
      if (!chunks.length){ reject(new Error('Recorder produced no data.')); return; }
      const blob = new Blob(chunks, { type: 'video/webm' });
      resolve(blob);
    };
    if (masterGain) masterGain.gain.value = 0;
    rec.start(200);
    await new Promise(r => setTimeout(r, 200));
    setPlayhead(0);
    setPlaying(true);
    const deadline = performance.now() + dur * 1000 + 20000;
    const monitor = () => {
      const pct = Math.min(99, Math.round((state.playhead / dur) * 100));
      onProgress && onProgress(pct);
      const done = state.playhead >= dur - 0.03 || !state.playing;
      const timedOut = performance.now() > deadline;
      if (done || timedOut){
        setPlaying(false); setPlayhead(dur);
        setTimeout(() => { if (rec.state !== 'inactive') rec.stop(); }, 800);
        return;
      }
      requestAnimationFrame(monitor);
    };
    requestAnimationFrame(monitor);
  });
}

