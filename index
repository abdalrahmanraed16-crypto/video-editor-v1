const drawCanvas = $('#drawCanvas');
const drawCtx = drawCanvas.getContext('2d');
let strokes = [], currentStroke = null, drawEraser = false;
function getDrawPos(e){
  const r = drawCanvas.getBoundingClientRect();
  return { x: (e.clientX - r.left) * drawCanvas.width / r.width,
           y: (e.clientY - r.top) * drawCanvas.height / r.height };
}
function redrawAllStrokes(){
  drawCtx.clearRect(0, 0, drawCanvas.width, drawCanvas.height);
  drawCtx.lineCap = 'round'; drawCtx.lineJoin = 'round';
  for (const s of strokes){
    drawCtx.globalCompositeOperation = s.eraser ? 'destination-out' : 'source-over';
    drawCtx.strokeStyle = s.color; drawCtx.fillStyle = s.color;
    drawCtx.lineWidth = s.size;
    if (s.points.length === 1){
      drawCtx.beginPath();
      drawCtx.arc(s.points[0].x, s.points[0].y, s.size / 2, 0, Math.PI * 2);
      drawCtx.fill();
    } else {
      drawCtx.beginPath();
      drawCtx.moveTo(s.points[0].x, s.points[0].y);
      for (let i = 1; i < s.points.length; i++) drawCtx.lineTo(s.points[i].x, s.points[i].y);
      drawCtx.stroke();
    }
  }
  drawCtx.globalCompositeOperation = 'source-over';
}
drawCanvas.addEventListener('pointerdown', e => {
  drawCanvas.setPointerCapture(e.pointerId);
  const p = getDrawPos(e);
  currentStroke = { color: drawEraser ? '#000' : $('#brushColor').value,
    size: +$('#brushSize').value, eraser: drawEraser, points: [p] };
  strokes.push(currentStroke); redrawAllStrokes(); e.preventDefault();
});
drawCanvas.addEventListener('pointermove', e => {
  if (!currentStroke) return;
  const p = getDrawPos(e);
  currentStroke.points.push(p);
  const n = currentStroke.points.length;
  const last = currentStroke.points[n - 2];
  drawCtx.globalCompositeOperation = currentStroke.eraser ? 'destination-out' : 'source-over';
  drawCtx.strokeStyle = currentStroke.color;
  drawCtx.lineCap = 'round'; drawCtx.lineJoin = 'round';
  drawCtx.lineWidth = currentStroke.size;
  drawCtx.beginPath(); drawCtx.moveTo(last.x, last.y); drawCtx.lineTo(p.x, p.y); drawCtx.stroke();
  drawCtx.globalCompositeOperation = 'source-over';
  e.preventDefault();
});
function endStroke(){ currentStroke = null; }
drawCanvas.addEventListener('pointerup', endStroke);
drawCanvas.addEventListener('pointercancel', endStroke);
drawCanvas.addEventListener('pointerleave', e => { if (currentStroke) endStroke(e); });
$('#brushColor').oninput = e => {
  $('#brushPreviewDot').style.background = e.target.value;
  if (drawEraser){ drawEraser = false; $('#eraserBtn').classList.remove('active'); }
};
$('#brushSize').oninput = e => {
  const s = +e.target.value;
  const dot = $('#brushPreviewDot');
  const shown = Math.min(s, 28);
  dot.style.width = shown + 'px'; dot.style.height = shown + 'px';
};
$('#eraserBtn').onclick = () => { drawEraser = !drawEraser; $('#eraserBtn').classList.toggle('active', drawEraser); };
$('#undoDraw').onclick = () => { strokes.pop(); redrawAllStrokes(); };
$('#clearDraw').onclick = () => {
  if (!strokes.length) return;
  if (!confirm('Clear the whole drawing?')) return;
  strokes = []; redrawAllStrokes();
};
$('#saveDraw').onclick = () => {
  if (!strokes.length){ toast('Draw something first.'); return; }
  const dataUrl = drawCanvas.toDataURL('image/png');
  const el = document.createElement('img'); el.src = dataUrl;
  const item = { id: uid(),
    name: '🎨 Drawing ' + new Date().toLocaleTimeString([], {hour:'2-digit', minute:'2-digit'}),
    type: 'image', url: dataUrl, el,
    duration: 5, w: drawCanvas.width, h: drawCanvas.height, thumb: null, ready: false };
  const finish = () => {
    item.w = el.naturalWidth || drawCanvas.width;
    item.h = el.naturalHeight || drawCanvas.height;
    item.ready = true; buildThumb(item);
  };
  if (el.complete && el.naturalWidth) finish(); else el.onload = finish;
  addMediaItem(item); closeDrawModal(); switchTab('media');
  toast('Drawing saved to media');
};
function openDrawModal(){
  $('#drawModal').classList.remove('hidden');
  strokes = []; currentStroke = null; drawEraser = false;
  $('#eraserBtn').classList.remove('active'); redrawAllStrokes();
}
function closeDrawModal(){ $('#drawModal').classList.add('hidden'); }
$('#newDrawingBtn').onclick = openDrawModal;
$('#closeDraw').onclick = closeDrawModal;
$('#drawModal').addEventListener('click', e => { if (e.target.id === 'drawModal') closeDrawModal(); });
window.addEventListener('keydown', e => {
