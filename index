function detectMoodText(prompt){
  const p = (prompt || '').toLowerCase();
  if (/documentary|nature|wildlife|history|planet|species/.test(p)) return 'documentary';
  if (/travel|journey|adventure|explore|wander/.test(p)) return 'travel';
  if (/motivat|inspir|quote|success|hustle|grind/.test(p)) return 'motivational';
  return 'cinematic';
}
function generateLocalText(prompt, ctx2){
  const bank = AI_WORDS[detectMoodText(prompt)];
  const o = pick(bank.open), m = pick(bank.mid), c = pick(bank.close);
  const kw = ctx2 && ctx2.keywords && ctx2.keywords.length ? ctx2.keywords : [];
  const topic = kw[0] || (prompt || '').trim().split(/\s+/).find(w => w.length > 4);
  if (topic && Math.random() > 0.35) return `${o} — ${m} of ${topic.toLowerCase()} ${c}`;
  return `${o}, ${m} ${c}`;
}
async function aiGenerateText(prompt, ctx2){
  const useApi = $('#aiUseApi').checked;
  const key = localStorage.getItem('videoeditor_openai_key');
  if (useApi && key){
    setAiStatus('Contacting OpenAI…', 'busy');
    try{
      const sys = ctx2 && ctx2.summary
        ? `You write short punchy video titles. Context: ${ctx2.summary.slice(0, 400)}`
        : 'You write short punchy video titles.';
      const res = await fetch('https://api.openai.com/v1/chat/completions', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + key },
        body: JSON.stringify({ model: 'gpt-4o-mini',
          messages: [
            { role: 'system', content: sys + ' Return only the text, no quotes, under 20 words.' },
            { role: 'user', content: prompt || 'A cinematic title' }
          ], max_tokens: 60 })
      });
      if (!res.ok) throw new Error('HTTP ' + res.status);
      const data = await res.json();
      return (data.choices[0].message.content || '').trim().replace(/^["']|["']$/g, '');
    } catch(e){
      setAiStatus('API failed — using local.', 'err');
      await new Promise(r => setTimeout(r, 500));
    }
  }
  setAiStatus('Writing text…', 'busy');
  await new Promise(r => setTimeout(r, 300));
  return generateLocalText(prompt, ctx2);
}
async function aiGenerateImage(prompt, style, ctx2){
  const useApi = $('#aiUseApi').checked;
  const key = localStorage.getItem('videoeditor_openai_key');
  if (useApi && key){
    setAiStatus('Contacting DALL·E…', 'busy');
    try{
      const fullPrompt = ctx2 && ctx2.summary
        ? `${prompt}. Context: ${ctx2.summary.slice(0, 200)}` : prompt;
      const res = await fetch('https://api.openai.com/v1/images/generations', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + key },
        body: JSON.stringify({ model: 'dall-e-3', prompt: fullPrompt || 'abstract art',
          n: 1, size: '1024x1024', response_format: 'b64_json' })
      });
      if (!res.ok) throw new Error('HTTP ' + res.status);
      const data = await res.json();
      const el = new Image();
      el.src = 'data:image/png;base64,' + data.data[0].b64_json;
      await el.decode();
      return el;
    } catch(e){
      setAiStatus('API failed — using local.', 'err');
      await new Promise(r => setTimeout(r, 500));
    }
  }
  setAiStatus('Drawing scene locally…', 'busy');
  const c = document.createElement('canvas');
  c.width = W; c.height = H;
  const cx = c.getContext('2d');
  const frames = 8;
  for (let f = 0; f < frames; f++){
    renderAIScene(cx, W, H, prompt, f * 0.08, style, ctx2);
    setProgress((f / frames) * 100);
    await new Promise(r => requestAnimationFrame(r));
  }
  setProgress(100);
  const el = new Image();
  el.src = c.toDataURL('image/png');
  await el.decode();
  return el;
}
async function aiGenerateVideo(prompt, style, duration, ctx2){
  setAiStatus('Recording video…', 'busy');
  const c = document.createElement('canvas');
  c.width = W; c.height = H;
  const cx = c.getContext('2d');
  const stream = c.captureStream(30);
  const candidates = ['video/webm;codecs=vp9','video/webm;codecs=vp8','video/webm'];
  const mimeType = candidates.find(t => MediaRecorder.isTypeSupported(t)) || '';
  const rec = new MediaRecorder(stream, { mimeType, videoBitsPerSecond: 6_000_000 });
  const chunks = [];
  rec.ondataavailable = e => { if (e.data && e.data.size) chunks.push(e.data); };
  const stopped = new Promise(r => rec.onstop = r);
  rec.start();
  const start = performance.now();
  const drawLoop = () => {
    const t = (performance.now() - start) / 1000;
    renderAIScene(cx, W, H, prompt, t, style, ctx2);
    setProgress(Math.min(100, (t / duration) * 100));
    if (t < duration) requestAnimationFrame(drawLoop);
    else { setProgress(100); setTimeout(() => rec.stop(), 120); }
  };
  requestAnimationFrame(drawLoop);
  await stopped;
  const blob = new Blob(chunks, { type: 'video/webm' });
  const url = URL.createObjectURL(blob);
  const el = document.createElement('video');
  el.src = url; el.muted = true; el.playsInline = true; el.preload = 'auto';
  el.setAttribute('playsinline','');
  await new Promise(res => {
    el.onloadedmetadata = () => res();
    el.onerror = () => res();
    setTimeout(res, 2500);
  });
  return { el, url, duration: el.duration || duration };
}
function aiGenerateDraw(prompt, style, ctx2){
  const c = document.createElement('canvas');
  c.width = W; c.height = H;
  const cx = c.getContext('2d');
  renderAIScene(cx, W, H, prompt, 0, style, ctx2);
  const imgData = cx.getImageData(0, 0, W, H);
  const d = imgData.data;
  const orig = new Uint8ClampedArray(d);
  for (let y = 1; y < H - 1; y++){
    for (let x = 1; x < W - 1; x++){
      const i = (y * W + x) * 4;
      const il = (y * W + x - 1) * 4;
      const iR = (y * W + x + 1) * 4;
      const ir = ((y - 1) * W + x) * 4;
      const iD = ((y + 1) * W + x) * 4;
      const gl = (orig[il] + orig[il+1] + orig[il+2]) / 3;
      const gr = (orig[iR] + orig[iR+1] + orig[iR+2]) / 3;
      const gu = (orig[ir] + orig[ir+1] + orig[ir+2]) / 3;
      const gd = (orig[iD] + orig[iD+1] + orig[iD+2]) / 3;
      const edge = Math.abs(gl - gr) + Math.abs(gu - gd);
      const lum = (orig[i] + orig[i+1] + orig[i+2]) / 3;
      const v = 255 - edge * 1.8 - (255 - lum) * 0.35;
      d[i] = d[i+1] = d[i+2] = clamp(v, 0, 255);
      d[i+3] = 255;
    }
  }
  cx.putImageData(imgData, 0, 0);
  const el = new Image();
  el.src = c.toDataURL('image/png');
  return new Promise(res => { el.onload = () => res(el); if (el.complete) res(el); });
}

