/* =========================================================
   8. Pixel effects
   ========================================================= */
function applyPixelEffects(imageData, effects, t){
  const data = imageData.data;
  const w = imageData.width, h = imageData.height;
  const needsSrc = effects.some(e => ['water','lava','glitch'].includes(e.type));
  const src = needsSrc ? new Uint8ClampedArray(data) : null;
  for (const e of effects){
    const inten = e.intensity ?? 0.6;
    if (e.type === 'water'){
      const amp = inten * 14;
      for (let y = 0; y < h; y++){
        const off = Math.round(Math.sin((y / h) * Math.PI * 6 + t * 3) * amp);
        for (let x = 0; x < w; x++){
          const sx = clamp(x + off, 0, w - 1);
          const di = (y * w + x) * 4, si = (y * w + sx) * 4;
          data[di] = src[si]; data[di+1] = src[si+1]; data[di+2] = src[si+2];
        }
      }
    } else if (e.type === 'lava'){
      const amp = inten * 9;
      for (let y = 0; y < h; y++){
        const off = Math.round(Math.sin(y * 0.12 + t * 5) * amp * (y / h));
        for (let x = 0; x < w; x++){
          const sy = clamp(y + off, 0, h - 1);
          const di = (y * w + x) * 4, si = (sy * w + x) * 4;
          const heat = Math.sin(x * 0.05 + t * 3 + y * 0.03) * 0.5 + 0.5;
          const rB = 40 * inten * heat, gB = 12 * inten * heat;
          data[di] = Math.min(255, src[si] * 1.15 + rB);
          data[di+1] = Math.min(255, src[si+1] * 0.9 + gB);
          data[di+2] = Math.min(255, src[si+2] * 0.55);
        }
      }
    } else if (e.type === 'glitch'){
      const bands = 6 + Math.floor(inten * 10);
      for (let b = 0; b < bands; b++){
        const y0 = Math.floor(Math.random() * h);
        const bandH = Math.floor(4 + Math.random() * 22);
        const shift = Math.round((Math.random() - 0.5) * inten * 50);
        for (let y = y0; y < Math.min(h, y0 + bandH); y++)
          for (let x = 0; x < w; x++){
            const sx = clamp(x + shift, 0, w - 1);
            const di = (y * w + x) * 4, si = (y * w + sx) * 4;
            data[di] = src[si]; data[di+1] = src[si+1]; data[di+2] = src[si+2];
          }
      }
    } else if (e.type === 'vhs'){
      for (let y = 0; y < h; y++){
        const dark = (y % 3 === 0) ? 1 - 0.32 * inten : 1;
        for (let x = 0; x < w; x++){
          const i = (y * w + x) * 4;
          data[i] = Math.min(255, data[i] * dark * 1.06);
          data[i+1] = Math.min(255, data[i+1] * dark);
          data[i+2] = Math.min(255, data[i+2] * dark * 1.14);
        }
      }
    } else if (e.type === 'pixelate'){
      const block = Math.max(2, Math.round(inten * 22));
      for (let y = 0; y < h; y += block)
        for (let x = 0; x < w; x += block){
          let r=0, g=0, b=0, n=0;
          for (let yy = y; yy < Math.min(h, y + block); yy++)
            for (let xx = x; xx < Math.min(w, x + block); xx++){
              const i = (yy * w + xx) * 4;
              r += data[i]; g += data[i+1]; b += data[i+2]; n++;
            }
          r /= n; g /= n; b /= n;
          for (let yy = y; yy < Math.min(h, y + block); yy++)
            for (let xx = x; xx < Math.min(w, x + block); xx++){
              const i = (yy * w + xx) * 4;
              data[i] = r; data[i+1] = g; data[i+2] = b;
            }
        }
    } else if (e.type === 'bw'){
      for (let i = 0; i < data.length; i += 4){
        const lum = data[i]*0.299 + data[i+1]*0.587 + data[i+2]*0.114;
        data[i] = data[i] * (1 - inten) + lum * inten;
        data[i+1] = data[i+1] * (1 - inten) + lum * inten;
        data[i+2] = data[i+2] * (1 - inten) + lum * inten;
      }
    } else if (e.type === 'sepia'){
      for (let i = 0; i < data.length; i += 4){
        const r = data[i], g = data[i+1], b = data[i+2];
        const sr = Math.min(255, r*0.393 + g*0.769 + b*0.189);
        const sg = Math.min(255, r*0.349 + g*0.686 + b*0.168);
        const sb = Math.min(255, r*0.272 + g*0.534 + b*0.131);
        data[i] = r * (1-inten) + sr * inten;
        data[i+1] = g * (1-inten) + sg * inten;
        data[i+2] = b * (1-inten) + sb * inten;
      }
    } else if (e.type === 'invert'){
      for (let i = 0; i < data.length; i += 4){
        data[i] = data[i] * (1-inten) + (255 - data[i]) * inten;
        data[i+1] = data[i+1] * (1-inten) + (255 - data[i+1]) * inten;
        data[i+2] = data[i+2] * (1-inten) + (255 - data[i+2]) * inten;
      }
    } else if (e.type === 'contrast'){
      const cc = 1 + inten * 1.4;
      for (let i = 0; i < data.length; i += 4){
        data[i] = clamp((data[i] - 128) * cc + 128, 0, 255);
        data[i+1] = clamp((data[i+1] - 128) * cc + 128, 0, 255);
        data[i+2] = clamp((data[i+2] - 128) * cc + 128, 0, 255);
      }
    } else if (e.type === 'tint'){
      const [tr,tg,tb] = hexToRgb(e.color || '#ffffff');
      for (let i = 0; i < data.length; i += 4){
        data[i] = data[i] * (1-inten) + tr * inten;
        data[i+1] = data[i+1] * (1-inten) + tg * inten;
        data[i+2] = data[i+2] * (1-inten) + tb * inten;
      }
    }
  }
}

/* =========================================================
   9. Preview rendering (refactored with transitions)
   ========================================================= */
function fadeAlpha(c, local){
  let a = c.opacity ?? 1;
  if (c.fadeIn) a *= clamp(local / c.fadeIn, 0, 1);
  if (c.fadeOut) a *= clamp((c.dur - local) / c.fadeOut, 0, 1);
  return clamp(a, 0, 1);
}
function wrapLinesForCtx(targetCtx, text, maxWidth){
  const words = String(text).split(/\s+/);
  const lines = []; let line = '';
  for (const w of words){
    const test = line ? line + ' ' + w : w;
    if (targetCtx.measureText(test).width > maxWidth && line){ lines.push(line); line = w; }
    else line = test;
  }
  if (line) lines.push(line);
  return lines.length ? lines : [''];
}
function renderTextToCanvas(c){
  if (!c._tc){
    c._tc = document.createElement('canvas');
    c._tc.width = W; c._tc.height = H;
    c._tcCtx = c._tc.getContext('2d');
  }
  const tc = c._tcCtx;
  tc.clearRect(0, 0, W, H);
  const size = c.fontSize || 64;
  const x = W * (c.x ?? 50) / 100;
  const y = H * (c.y ?? 50) / 100;
  tc.textAlign = c.align || 'center';
  tc.textBaseline = 'middle';
  tc.font = `800 ${size}px Inter, system-ui, sans-serif`;
  const lines = wrapLinesForCtx(tc, c.text || '', W * 0.88);
  const lh = size * 1.18;
  const top = y - (lines.length - 1) * lh / 2;
  lines.forEach((ln, i) => {
    tc.lineWidth = Math.max(3, size / 11);
    tc.strokeStyle = 'rgba(0,0,0,.8)';
    tc.lineJoin = 'round';
    tc.strokeText(ln, x, top + i * lh);
    tc.fillStyle = c.color || '#fff';
    tc.fillText(ln, x, top + i * lh);
  });
  return c._tc;
}

/* Refactored to accept a target context */
function drawSourceWithFxOn(targetCtx, source, sw, sh, c, localT){
  const effects = c.effects || [];
  let extraAlpha = 1;
  for (const e of effects){
    const inten = e.intensity ?? 0.6;
    if (e.type === 'blink'){
      const period = 0.25 + (1 - inten) * 1.2;
      const phase = (localT % period) / period;
      if (phase > 0.5) extraAlpha *= 0.05;
    }
    if (e.type === 'flicker') extraAlpha *= 1 - inten * Math.random() * 0.55;
  }
  const alpha = fadeAlpha(c, localT) * extraAlpha;
  if (alpha <= 0.01) return;
  const hasPixel = effects.some(e => PIXEL_TYPES.has(e.type));
  let renderSrc = source, renderW = sw, renderH = sh;
  if (hasPixel){
    fxCtx.setTransform(1,0,0,1,0,0);
    fxCtx.clearRect(0, 0, FX_W, FX_H);
    const scale = Math.min(FX_W / sw, FX_H / sh);
    const dw = sw * scale, dh = sh * scale;
    try { fxCtx.drawImage(source, (FX_W - dw) / 2, (FX_H - dh) / 2, dw, dh); } catch(err){ return; }
    const imgData = fxCtx.getImageData(0, 0, FX_W, FX_H);
    applyPixelEffects(imgData, effects, localT);
    fxCtx.putImageData(imgData, 0, 0);
    renderSrc = fxCanvas; renderW = FX_W; renderH = FX_H;
  }
  let sx = 1, sy = 1, ox = 0, oy = 0, rot = 0;
  for (const e of effects){
    const inten = e.intensity ?? 0.6;
    if (e.type === 'shake'){ ox += (Math.random() - 0.5) * inten * 34; oy += (Math.random() - 0.5) * inten * 34; }
    if (e.type === 'pulse'){ const s = 1 + Math.sin(localT * 6) * inten * 0.13; sx *= s; sy *= s; }
    if (e.type === 'slowzoom'){ const s = 1 + inten * Math.min(1, localT / 4) * 0.4; sx *= s; sy *= s; }
    if (e.type === 'rotate') rot += localT * inten * 1.6;
  }
  targetCtx.save();
  targetCtx.globalAlpha = alpha;
  targetCtx.translate(W / 2 + ox, H / 2 + oy);
  targetCtx.scale(sx, sy);
  targetCtx.rotate(rot);
  const scale = Math.min(W / renderW, H / renderH);
  const dw = renderW * scale, dh = renderH * scale;
  try { targetCtx.drawImage(renderSrc, -dw / 2, -dh / 2, dw, dh); } catch(err){}
  for (const e of effects){
    const inten = e.intensity ?? 0.6;
    if (e.type === 'vignette'){
      const grd = targetCtx.createRadialGradient(0, 0, Math.min(dw, dh) * 0.28, 0, 0, Math.max(dw, dh) * 0.72);
      grd.addColorStop(0, 'rgba(0,0,0,0)');
      grd.addColorStop(1, `rgba(0,0,0,${inten * 0.92})`);
      targetCtx.fillStyle = grd;
      targetCtx.fillRect(-dw / 2, -dh / 2, dw, dh);
    } else if (e.type === 'bloom'){
      const a = inten * 0.32 * (0.8 + Math.sin(localT * 2) * 0.2);
      const grd = targetCtx.createRadialGradient(0, 0, 0, 0, 0, Math.max(dw, dh) * 0.65);
      grd.addColorStop(0, `rgba(255,255,255,${a})`);
      grd.addColorStop(1, 'rgba(255,255,255,0)');
      targetCtx.fillStyle = grd;
      targetCtx.fillRect(-dw / 2, -dh / 2, dw, dh);
    }
  }
  targetCtx.restore();
}

/* Render a single clip (media or text) to any target context at local time */
function renderClipTo(targetCtx, c, localT){
  if (!c) return;
  if (c.kind === 'media'){
    const m = getMedia(c);
    if (!m) return;
    if (c.effects && c.effects.length){
      drawSourceWithFxOn(targetCtx, m.el, m.w, m.h, c, localT);
    } else {
      targetCtx.save();
      targetCtx.globalAlpha = fadeAlpha(c, localT);
      const scale = Math.min(W / m.w, H / m.h);
      const dw = m.w * scale, dh = m.h * scale;
      try { targetCtx.drawImage(m.el, (W - dw) / 2, (H - dh) / 2, dw, dh); } catch(e){}
      targetCtx.restore();
    }
  } else if (c.kind === 'text'){
    if (c.effects && c.effects.length){
      const tc = renderTextToCanvas(c);
      drawSourceWithFxOn(targetCtx, tc, W, H, c, localT);
    } else {
      const size = c.fontSize || 64;
      targetCtx.save();
      targetCtx.globalAlpha = fadeAlpha(c, localT);
      targetCtx.textAlign = c.align || 'center';
      targetCtx.textBaseline = 'middle';
      const x = W * (c.x ?? 50) / 100;
      const y = H * (c.y ?? 50) / 100;
      targetCtx.font = `800 ${size}px Inter, system-ui, sans-serif`;
      const lines = wrapLinesForCtx(targetCtx, c.text || '', W * 0.88);
      const lh = size * 1.18;
      const top = y - (lines.length - 1) * lh / 2;
      lines.forEach((ln, i) => {
        targetCtx.lineWidth = Math.max(3, size / 11);
        targetCtx.strokeStyle = 'rgba(0,0,0,.8)';
        targetCtx.lineJoin = 'round';
        targetCtx.strokeText(ln, x, top + i * lh);
        targetCtx.fillStyle = c.color || '#fff';
        targetCtx.fillText(ln, x, top + i * lh);
      });
      targetCtx.restore();
    }
  }
}

/* =========================================================
   9b. Transition renderer
   ========================================================= */
function drawTransition(targetCtx, tA, tB, type, p){
  const w = W, h = H;
  p = clamp(p, 0, 1);
  targetCtx.save();
  targetCtx.setTransform(1, 0, 0, 1, 0, 0);
  targetCtx.globalAlpha = 1;
  targetCtx.globalCompositeOperation = 'source-over';
  targetCtx.filter = 'none';

  switch(type){
    case 'fade':
      targetCtx.globalAlpha = 1 - p;
      targetCtx.drawImage(tA, 0, 0);
      targetCtx.globalAlpha = p;
      targetCtx.drawImage(tB, 0, 0);
      break;

    case 'fadeblack':
      targetCtx.fillStyle = '#000';
      targetCtx.fillRect(0, 0, w, h);
      if (p < 0.5){
        targetCtx.globalAlpha = 1 - p * 2;
        targetCtx.drawImage(tA, 0, 0);
      } else {
        targetCtx.globalAlpha = (p - 0.5) * 2;
        targetCtx.drawImage(tB, 0, 0);
      }
      break;

    case 'fadewhite':
      targetCtx.fillStyle = '#fff';
      targetCtx.fillRect(0, 0, w, h);
      if (p < 0.5){
        targetCtx.globalAlpha = 1 - p * 2;
        targetCtx.drawImage(tA, 0, 0);
      } else {
        targetCtx.globalAlpha = (p - 0.5) * 2;
        targetCtx.drawImage(tB, 0, 0);
      }
      break;

    case 'slideleft':
      targetCtx.drawImage(tA, -p * w, 0);
      targetCtx.drawImage(tB, (1 - p) * w, 0);
      break;

    case 'slideright':
      targetCtx.drawImage(tA, p * w, 0);
      targetCtx.drawImage(tB, -(1 - p) * w, 0);
      break;

    case 'slideup':
      targetCtx.drawImage(tA, 0, -p * h);
      targetCtx.drawImage(tB, 0, (1 - p) * h);
      break;

    case 'slidedown':
      targetCtx.drawImage(tA, 0, p * h);
      targetCtx.drawImage(tB, 0, -(1 - p) * h);
      break;

    case 'wipeleft':
      targetCtx.drawImage(tA, 0, 0);
      targetCtx.beginPath();
      targetCtx.rect(w * (1 - p), 0, w * p, h);
      targetCtx.clip();
      targetCtx.drawImage(tB, 0, 0);
      break;

    case 'wiperight':
      targetCtx.drawImage(tA, 0, 0);
      targetCtx.beginPath();
      targetCtx.rect(0, 0, w * p, h);
      targetCtx.clip();
      targetCtx.drawImage(tB, 0, 0);
      break;

    case 'wipeup':
      targetCtx.drawImage(tA, 0, 0);
      targetCtx.beginPath();
      targetCtx.rect(0, h * (1 - p), w, h * p);
      targetCtx.clip();
      targetCtx.drawImage(tB, 0, 0);
      break;

    case 'wipedown':
      targetCtx.drawImage(tA, 0, 0);
      targetCtx.beginPath();
      targetCtx.rect(0, 0, w, h * p);
      targetCtx.clip();
      targetCtx.drawImage(tB, 0, 0);
      break;

    case 'circleopen': {
      targetCtx.drawImage(tA, 0, 0);
      const r = Math.hypot(w, h) / 2 * p;
      targetCtx.beginPath();
      targetCtx.arc(w/2, h/2, r, 0, Math.PI * 2);
      targetCtx.clip();
      targetCtx.drawImage(tB, 0, 0);
      break;
    }

    case 'circleclose': {
      targetCtx.drawImage(tB, 0, 0);
      const r = Math.hypot(w, h) / 2 * (1 - p);
      targetCtx.beginPath();
      targetCtx.arc(w/2, h/2, r, 0, Math.PI * 2);
      targetCtx.clip();
      targetCtx.drawImage(tA, 0, 0);
      break;
    }

    case 'zoomin': {
      targetCtx.globalAlpha = 1 - p;
      targetCtx.drawImage(tA, 0, 0);
      const s = 0.4 + p * 0.6;
      targetCtx.globalAlpha = p;
      const dw = w * s, dh = h * s;
      targetCtx.drawImage(tB, (w - dw) / 2, (h - dh) / 2, dw, dh);
      break;
    }

    case 'zoomout': {
      const s = 1 + p * 0.8;
      targetCtx.globalAlpha = 1 - p;
      const dw = w * s, dh = h * s;
      targetCtx.drawImage(tA, (w - dw) / 2, (h - dh) / 2, dw, dh);
      targetCtx.globalAlpha = p;
      targetCtx.drawImage(tB, 0, 0);
      break;
    }

    case 'spin': {
      targetCtx.globalAlpha = 1 - p;
      targetCtx.translate(w/2, h/2);
      targetCtx.rotate(p * Math.PI);
      const sA = 1 - p * 0.6;
      targetCtx.scale(sA, sA);
      targetCtx.drawImage(tA, -w/2, -h/2);
      targetCtx.setTransform(1, 0, 0, 1, 0, 0);
      targetCtx.globalAlpha = p;
      targetCtx.translate(w/2, h/2);
      targetCtx.rotate(-(1 - p) * Math.PI);
      const sB = 0.4 + p * 0.6;
      targetCtx.scale(sB, sB);
      targetCtx.drawImage(tB, -w/2, -h/2);
      break;
    }

    case 'blur':
      targetCtx.globalAlpha = 1 - p;
      targetCtx.filter = `blur(${p * 14}px)`;
      targetCtx.drawImage(tA, 0, 0);
      targetCtx.globalAlpha = p;
      targetCtx.filter = `blur(${(1 - p) * 14}px)`;
      targetCtx.drawImage(tB, 0, 0);
      targetCtx.filter = 'none';
      break;

    case 'glitch': {
      targetCtx.globalAlpha = 1 - p;
      targetCtx.drawImage(tA, 0, 0);
      targetCtx.globalAlpha = p;
      targetCtx.drawImage(tB, 0, 0);
      targetCtx.globalAlpha = 1;
      const intensity = 1 - Math.abs(p - 0.5) * 2;
      const bands = 4 + Math.floor(intensity * 12);
      for (let i = 0; i < bands; i++){
        const y = Math.random() * h;
        const bandH = 3 + Math.random() * 22;
        const shift = (Math.random() - 0.5) * 90 * intensity;
        const src = Math.random() > 0.5 ? tA : tB;
        try {
          targetCtx.drawImage(src, 0, y, w, bandH, shift, y, w, bandH);
        } catch(err){}
      }
      break;
    }

    case 'mosaic': {
      targetCtx.drawImage(tA, 0, 0);
      const blockSize = 40;
      const cols = Math.ceil(w / blockSize);
      const rows = Math.ceil(h / blockSize);
      for (let r = 0; r < rows; r++){
        for (let cI = 0; cI < cols; cI++){
          const seed = hash(r * 137 + cI * 43);
          if (seed < p){
            targetCtx.drawImage(
              tB,
              cI * blockSize, r * blockSize, blockSize, blockSize,
              cI * blockSize, r * blockSize, blockSize, blockSize
            );
          }
        }
      }
      break;
    }

    default:
      targetCtx.drawImage(tB, 0, 0);
  }

  targetCtx.restore();
}

/* Render a single track (0=video, 1=text, 2=audio) at time t */
function renderTrack(t, trackNum){
  // Find the primary clip on this track
  const primary = state.clips.find(c =>
    c.track === trackNum && t >= c.start && t < c.start + c.dur);
  if (!primary) return;

  const local = t - primary.start;
  const transIn = primary.transIn || { type: 'none', dur: 0 };
  const inTransition = transIn.type !== 'none' && transIn.dur > 0 && local < transIn.dur;

  if (inTransition){
    const prev = getPrevAdjacentClip(primary);
    if (prev){
      // Previous clip's extended local time = its dur + current offset
      const prevLocal = prev.dur + local;
      tmpACtx.setTransform(1,0,0,1,0,0);
      tmpBCtx.setTransform(1,0,0,1,0,0);
      tmpACtx.clearRect(0, 0, W, H);
      tmpBCtx.clearRect(0, 0, W, H);
      renderClipTo(tmpACtx, prev, prevLocal);
      renderClipTo(tmpBCtx, primary, local);
      const progress = local / transIn.dur;
      drawTransition(ctx, tmpACanvas, tmpBCanvas, transIn.type, progress);
      return;
    }
  }

  // No transition — render normally
  renderClipTo(ctx, primary, local);
}

function renderPreview(t){
  ctx.setTransform(1, 0, 0, 1, 0, 0);
  ctx.globalAlpha = 1;
  ctx.fillStyle = '#000';
  ctx.fillRect(0, 0, W, H);

  // Track 0 = video/images/drawings, Track 1 = text overlays
  renderTrack(t, 0);
  renderTrack(t, 1);
}

/* =========================================================
   10. Audio graph
   ========================================================= */
let audioCtx = null, masterGain = null, streamDest = null;
const audioNodes = new Map();
function ensureAudio(){
  try{
    if (!audioCtx){
      const AC = window.AudioContext || window.webkitAudioContext;
      if (!AC) return;
      audioCtx = new AC();
      masterGain = audioCtx.createGain();
      masterGain.gain.value = 1;
      masterGain.connect(audioCtx.destination);
      streamDest = audioCtx.createMediaStreamDestination();
    }
    if (audioCtx.state === 'suspended') audioCtx.resume();
    state.media.forEach(m => {
      if (m.type === 'image') return;
      if (audioNodes.has(m.id)) return;
      try{
        const src = audioCtx.createMediaElementSource(m.el);
        src.connect(masterGain); src.connect(streamDest);
        audioNodes.set(m.id, src);
      } catch(e){}
    });
  } catch(e){ console.warn('audio init', e); }
}

/* =========================================================
   11. Sync + loop
   ========================================================= */
function syncMedia(t, playing){
  state.clips.forEach(c => {
    if (c.kind !== 'media') return;
    const m = getMedia(c);
    if (!m || m.type === 'image') return;
    const el = m.el;
    const active = t >= c.start && t < c.start + c.dur;
    const target = (c.in || 0) + (t - c.start);
    if (!active){ if (!el.paused) el.pause(); return; }
    el.volume = clamp(c.volume ?? 1, 0, 1);
    if (playing){
      if (el.paused){ try { el.currentTime = Math.max(0, target); } catch(e){} el.play().catch(() => {}); }
      else if (Math.abs(el.currentTime - target) > 0.3){ try { el.currentTime = target; } catch(e){} }
    } else {
      if (!el.paused) el.pause();
      if (!el.seeking && Math.abs(el.currentTime - target) > 0.05){
        try { el.currentTime = Math.max(0, target); } catch(e){}
      }
    }
  });
}
function setPlaying(v){
  if (v){
    const d = totalDuration();
    if (d <= 0) return;
    if (state.playhead >= d - 0.01) state.playhead = 0;
    ensureAudio();
  }
  state.playing = v;
  $('#playBtn').textContent = v ? '⏸' : '▶';
}
function autoScroll(){
  const sc = $('#lanesScroll');
  const x = state.playhead * state.pps;
  if (x < sc.scrollLeft + 20 || x > sc.scrollLeft + sc.clientWidth - 90)
    sc.scrollLeft = Math.max(0, x - 120);
}
let lastTs = 0;
function loop(ts){
  requestAnimationFrame(loop);
  const dt = lastTs ? Math.min(0.1, (ts - lastTs) / 1000) : 0;
  lastTs = ts;
  if (state.playing){
    state.playhead += dt;
    const d = totalDuration();
    if (state.playhead >= d){ state.playhead = d; setPlaying(false); }
  }
  syncMedia(state.playhead, state.playing);
  renderPreview(state.playhead);
  updatePlayheadUI(); updateTimeUI();
  if (state.playing) autoScroll();
}
requestAnimationFrame(loop);

