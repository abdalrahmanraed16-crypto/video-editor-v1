    <input type="range" id="pVol" min="0" max="100" value="${Math.round((c.volume ?? 1) * 100)}">
    <label>Opacity <span id="pOpVal">${Math.round((c.opacity ?? 1) * 100)}%</span></label>
    <input type="range" id="pOp" min="0" max="100" value="${Math.round((c.opacity ?? 1) * 100)}">
    <div class="two">
      <div><label>Fade in</label><input type="number" id="pFi" step="0.1" min="0" value="${c.fadeIn || 0}"></div>
      <div><label>Fade out</label><input type="number" id="pFo" step="0.1" min="0" value="${c.fadeOut || 0}"></div>
    </div>
    ${effectsSectionHtml(c)}
    ${transitionSectionHtml(c)}
    <div class="infoLine">
      Starts ${fmt(c.start)} · Ends ${fmt(c.start + c.dur)}<br>
      Source in ${((c.in || 0)).toFixed(2)}s → ${(((c.in || 0)) + c.dur).toFixed(2)}s
    </div>`;
  if (isImage){
    $('#pStill').oninput = e => { c.dur = Math.max(0.5, +e.target.value || 0.5); renderTimeline(); };
  } else {
    $('#pIn').oninput = e => {
      const v = clamp(+e.target.value || 0, 0, maxDur - 0.1);
      c.in = v; c.dur = Math.min(c.dur, maxDur - v); renderTimeline();
    };
    $('#pDur').oninput = e => {
      c.dur = clamp(+e.target.value || 0.1, 0.1, maxDur - (c.in || 0)); renderTimeline();
    };
  }
  $('#pVol').oninput = e => { c.volume = +e.target.value / 100; $('#pVolVal').textContent = e.target.value + '%'; };
  $('#pOp').oninput = e => { c.opacity = +e.target.value / 100; $('#pOpVal').textContent = e.target.value + '%'; };
  $('#pFi').oninput = e => { c.fadeIn = Math.max(0, +e.target.value); };
  $('#pFo').oninput = e => { c.fadeOut = Math.max(0, +e.target.value); };
  bindFxRows(c);
  bindTransitionRows(c);
}

