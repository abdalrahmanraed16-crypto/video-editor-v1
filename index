function detectScene(prompt, ctx2){
  const extra = ctx2 ? (ctx2.keywords || []).join(' ') + ' ' + (ctx2.title || '') + ' ' + (ctx2.summary || '') : '';
  const p = (prompt + ' ' + extra).toLowerCase();
  const has = re => re.test(p);
  return {
    night: has(/night|dark|midnight|moon|stars|evening|dusk/),
    sunset: has(/sunset|dusk|golden|evening|warm/),
    sunrise: has(/sunrise|dawn|morning/),
    storm: has(/storm|thunder|cloudy|overcast|rainy/),
    snow: has(/snow|winter|ice|frost|blizzard|cold|glacier|arctic|antarctic/),
    space: has(/space|galaxy|cosmic|planet|universe|nebula|astro|stars|orbit/),
    ocean: has(/ocean|sea|lake|underwater|aquarium|reef|coral/),
    beach: has(/beach|shore|coast|island|sand|palm/),
    forest: has(/forest|tree|wood|jungle|pine|rainforest|amazon/),
    city: has(/city|urban|building|town|skyline|downtown|street|tokyo|paris|london|new york/),
    mountains: has(/mountain|hill|peak|valley|alps|fuji|everest|andes|rockies/),
    fire: has(/fire|flame|lava|volcano|burn|ember|hell|eruption/),
    desert: has(/desert|sand|dune|sahara/),
    moon: has(/moon|lunar/),
    sun: has(/sun|sunny/),
    car: has(/car|auto|vehicle|truck|driving|road/),
    house: has(/house|home|cabin|hut|cottage|villa/),
    boat: has(/boat|ship|sail|yacht|cruise/),
    rocket: has(/rocket|spaceship|spacecraft|launch|nasa|spacex/),
    flower: has(/flower|bloom|rose|garden|tulip|daisy|cherry|blossom|sakura/),
    person: has(/person|people|man|woman|figure|human|silhouette|character/),
    cat: has(/\bcat\b|kitten|tiger|lion|leopard|panther|panda|feline/),
    dog: has(/\bdog\b|puppy|wolf|fox|coyote|canine/),
    bird: has(/bird|eagle|crow|flying|seagull|owl|hawk|parrot|penguin/),
    butterfly: has(/butterfly/),
    heart: has(/heart|love|valentine/),
    balloon: has(/balloon|birthday|party/),
    fish: has(/fish|shark|whale|dolphin|penguin|seal/),
    tree: has(/\btree\b|palm/),
    rain: has(/rain|downpour|monsoon/),
    aurora: has(/aurora|borealis|australis|northern lights/),
    wildlife: has(/wildlife|animal|creature|beast|safari/),
    ice: has(/iceberg|glacier|ice|frozen|arctic/),
    tropical: has(/tropical|jungle|palm|hawaii|bali|caribbean/)
  };
}
function drawSky(cx, W, H, sc, t){
  let top, bot;
  if (sc.space){ top = '#05030d'; bot = '#0a0520'; }
  else if (sc.aurora){ top = '#0a0a2a'; bot = '#0a1a3a'; }
  else if (sc.night){ top = '#080e24'; bot = '#1a2244'; }
  else if (sc.sunset){ top = '#2a1a3a'; bot = '#ff7048'; }
  else if (sc.sunrise){ top = '#4a2a5a'; bot = '#ffb070'; }
  else if (sc.storm){ top = '#2a2f3a'; bot = '#5a6474'; }
  else if (sc.snow){ top = '#6a7890'; bot = '#c8d4e2'; }
  else { top = '#4a90d4'; bot = '#c8e6f5'; }
  const g = cx.createLinearGradient(0, 0, 0, H);
  g.addColorStop(0, top); g.addColorStop(1, bot);
  cx.fillStyle = g; cx.fillRect(0, 0, W, H);
}
function drawStars(cx, W, H, t, count=200){
  for (let i = 0; i < count; i++){
    const x = hash(i * 3.7) * W, y = hash(i * 5.3) * H, s = hash(i * 7.1);
    const twinkle = 0.5 + 0.5 * Math.sin(t * 2 + i);
    cx.fillStyle = `rgba(255,255,255,${(0.3 + s * 0.7) * twinkle})`;
    cx.fillRect(x, y, 1 + s * 2, 1 + s * 2);
  }
}
function drawAurora(cx, W, H, t){
  for (let band = 0; band < 6; band++){
    const baseY = H * 0.15 + band * 25;
    const hue = 140 + band * 20 + Math.sin(t * 0.4 + band) * 30;
    const alpha = 0.35 - band * 0.04;
    cx.beginPath(); cx.moveTo(0, H);
    for (let x = 0; x <= W; x += 12){
      const y = baseY + Math.sin(x * 0.008 + t * 0.7 + band * 1.2) * 60
                       + Math.sin(x * 0.02 + t * 1.3) * 25;
      cx.lineTo(x, y);
    }
    cx.lineTo(W, H); cx.closePath();
    const g = cx.createLinearGradient(0, baseY - 80, 0, baseY + 200);
    g.addColorStop(0, `hsla(${hue},80%,65%,0)`);
    g.addColorStop(0.4, `hsla(${hue},80%,60%,${alpha})`);
    g.addColorStop(1, `hsla(${hue + 40},80%,50%,0)`);
    cx.fillStyle = g; cx.fill();
  }
}
function drawSun(cx, W, H, t, warm){
  const x = W * 0.5, y = H * 0.26, r = 58;
  const glow = cx.createRadialGradient(x, y, 0, x, y, r * 5);
  if (warm){
    glow.addColorStop(0, 'rgba(255,245,200,0.95)');
    glow.addColorStop(0.15, 'rgba(255,190,90,0.7)');
    glow.addColorStop(0.5, 'rgba(255,110,60,0.25)');
    glow.addColorStop(1, 'rgba(255,80,40,0)');
  } else {
    glow.addColorStop(0, 'rgba(255,250,210,1)');
    glow.addColorStop(0.15, 'rgba(255,230,140,0.7)');
    glow.addColorStop(0.5, 'rgba(255,210,90,0.22)');
    glow.addColorStop(1, 'rgba(255,210,90,0)');
  }
  cx.fillStyle = glow;
  cx.beginPath(); cx.arc(x, y, r * 5, 0, Math.PI * 2); cx.fill();
  cx.fillStyle = warm ? '#fff2c8' : '#fffbe0';
  cx.beginPath(); cx.arc(x, y, r, 0, Math.PI * 2); cx.fill();
}
function drawMoon(cx, W, H, t){
  const x = W * 0.74, y = H * 0.2, r = 45;
  const glow = cx.createRadialGradient(x, y, 0, x, y, r * 3.5);
  glow.addColorStop(0, 'rgba(230,235,255,0.55)');
  glow.addColorStop(1, 'rgba(200,200,255,0)');
  cx.fillStyle = glow;
  cx.beginPath(); cx.arc(x, y, r * 3.5, 0, Math.PI * 2); cx.fill();
  cx.fillStyle = '#eaeaff';
  cx.beginPath(); cx.arc(x, y, r, 0, Math.PI * 2); cx.fill();
  cx.fillStyle = 'rgba(180,180,200,0.5)';
  cx.beginPath(); cx.arc(x - 12, y - 8, 6, 0, Math.PI * 2); cx.fill();
  cx.beginPath(); cx.arc(x + 10, y + 6, 4, 0, Math.PI * 2); cx.fill();
  cx.beginPath(); cx.arc(x - 3, y + 14, 3, 0, Math.PI * 2); cx.fill();
}
