    body.innerHTML = '<div class="srEmpty">No results found — try a different prompt.</div>';
    return;
  }
  panel.classList.add('show');
  count.textContent = `${data.images.length} img · ${data.related.length} pages`;
  let html = '';
  html += `<div class="srTitle">📖 ${esc(data.title)}`;
  if (data.url) html += ` <a href="${esc(data.url)}" target="_blank" rel="noopener">↗</a>`;
  html += `</div>`;
  if (data.summary) html += `<div class="srSummary">${esc(data.summary)}</div>`;
  if (data.keywords.length){
    html += `<div class="srSectionLabel">Keywords</div>`;
    html += `<div class="srKeywords">` +
      data.keywords.map(k => `<span class="srKeyword">${esc(k)}</span>`).join('') + `</div>`;
  }
  if (data.images.length){
    html += `<div class="srSectionLabel">Photos (tap to import)</div>`;
    html += `<div class="srImagesGrid" id="srImagesGrid">`;
    data.images.forEach((img, i) => {
      html += `<div class="srImgWrap loading" data-i="${i}">
        <img src="${esc(img.thumb)}" alt="" loading="lazy"
             onload="this.parentElement.classList.remove('loading')"
             onerror="this.parentElement.classList.remove('loading')">
        <div class="srImgAdd">＋</div>
      </div>`;
    });
    html += `</div>`;
  }
  if (data.related.length > 1){
    html += `<div class="srSectionLabel">Related</div>`;
    html += `<div class="srRelated">` +
      data.related.slice(0, 6).map(r =>
        `<span class="srRelatedChip" data-title="${esc(r)}">${esc(r)}</span>`).join('') + `</div>`;
  }
  body.innerHTML = html;
  $$('#srImagesGrid .srImgWrap').forEach(wrap => {
