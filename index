function renderAIScene(cx, W, H, prompt, t, mood, ctx2){
  const sc = detectScene(prompt, ctx2);
  if (mood === 'night'){ sc.night = true; sc.sunset = false; sc.snow = false; sc.storm = false; sc.space = false; sc.aurora = false; }
  else if (mood === 'sunset'){ sc.sunset = true; sc.night = false; sc.snow = false; sc.storm = false; sc.space = false; sc.aurora = false; }
  else if (mood === 'day'){ sc.night = false; sc.sunset = false; sc.storm = false; sc.snow = false; sc.space = false; sc.aurora = false; }
  else if (mood === 'storm'){ sc.storm = true; sc.night = false; sc.snow = false; sc.sunset = false; sc.aurora = false; }
  else if (mood === 'snow'){ sc.snow = true; sc.night = false; sc.sunset = false; sc.storm = false; sc.aurora = false; }
  else if (mood === 'space'){ sc.space = true; sc.night = true; sc.aurora = false; }
  const horizonY = H * 0.62;
  const groundY = H * 0.72;
  drawSky(cx, W, H, sc, t);
  if (sc.space){
    drawStars(cx, W, H * 0.9, t, 300);
    for (let i = 0; i < 6; i++){
      const x = hash(i * 11) * W, y = hash(i * 13) * H * 0.85;
      const r = 120 + hash(i * 17) * 200;
      const hue = (hash(i * 19) * 360 + t * 5) % 360;
      const g = cx.createRadialGradient(x, y, 0, x, y, r);
      g.addColorStop(0, `hsla(${hue},80%,60%,0.25)`);
      g.addColorStop(1, 'hsla(0,0,0,0)');
      cx.fillStyle = g;
      cx.fillRect(x - r, y - r, r * 2, r * 2);
    }
  }
  if (sc.night && !sc.space) drawStars(cx, W, H * 0.75, t, 150);
  if (sc.aurora){ drawStars(cx, W, H * 0.75, t, 120); drawAurora(cx, W, H, t); }
  if (sc.moon || (sc.night && !sc.sun)) drawMoon(cx, W, H, t);
  if (sc.sun || (!sc.night && !sc.space && !sc.aurora)) drawSun(cx, W, H, t, sc.sunset || sc.sunrise);
  if (!sc.space){
    const cloudCount = sc.storm ? 8 : 4;
    for (let i = 0; i < cloudCount; i++){
      const cx1 = (hash(i * 3.3) * W + t * 12 * (0.5 + hash(i))) % (W + 250) - 150;
      const cy1 = H * (0.05 + hash(i * 5.7) * 0.22);
      const cs = 0.6 + hash(i * 7.1) * 0.9;
      drawCloud(cx, cx1, cy1, cs, sc.storm ? 0.9 : 0.8);
    }
  }
  if (sc.mountains || sc.forest || sc.beach || sc.ocean || sc.ice){
    const mColor = sc.night ? '#161c28' : sc.snow ? '#c8d4e0' : sc.sunset ? '#4a3a52' : '#5a6a80';
    drawMountains(cx, W, H, horizonY, mColor, 7, 6);
  }
  if (sc.city) drawCity(cx, W, H, horizonY + 30, 100);
  if (sc.ocean || sc.beach || sc.fish || /water|sea|lake|ocean|beach|underwater|reef|coral/.test(prompt.toLowerCase()))
    drawOcean(cx, W, H, horizonY, t, sc.night);
  const isFullWater = sc.ocean && !sc.beach;
  if (!isFullWater){
    let kind = 'grass';
    if (sc.desert || sc.beach) kind = 'sand';
    else if (sc.snow || sc.ice) kind = 'snow';
    else if (sc.fire) kind = 'lava';
    drawGround(cx, W, H, groundY, kind, t);
  }
  if (sc.forest || sc.tree){
    const treeColor = sc.night ? '#0a1a0a' : sc.snow ? '#1a3a2a' : '#1a5a2a';
    const n = 9;
    for (let i = 0; i < n; i++){
      const x = (i + 0.5) * (W / n) + (hash(i * 3.3) - 0.5) * 40;
      const h = 130 + hash(i * 5.7) * 160;
      drawTree(cx, x, groundY + 30, h, treeColor);
    }
  }
  if (sc.house) drawHouse(cx, W * 0.35, groundY + 40, 220, t);
  if (sc.car) drawCar(cx, W * 0.7, groundY + 50, 250, pick(['#d04040','#4080d0','#40b060','#e0a030','#a040c0']));
  if (sc.rocket) drawRocket(cx, W * 0.5, groundY + 30, 220, t);
  if (sc.boat) drawBoat(cx, W * 0.55, horizonY + 60, 200, t);
  if (sc.cat) drawCat(cx, W * 0.4, groundY + 55, 90, sc.night ? '#1a1a1a' : (sc.tropical ? '#e08030' : '#c06030'));
  if (sc.dog) drawDog(cx, W * 0.6, groundY + 55, 100, '#8a5a2a');
  if (sc.fish || sc.ocean){
    for (let i = 0; i < 5; i++){
      const fx = (hash(i * 3.3) * W + t * 40 * (1 + hash(i))) % (W + 120) - 60;
      const fy = H * (0.72 + hash(i * 5.7) * 0.2);
      const sz = 14 + hash(i * 7.1) * 18;
      const hue = hash(i * 11) * 60 + 20;
      drawFish(cx, fx, fy, sz, `hsl(${hue},70%,60%)`, t);
    }
  }
  const birdCount = sc.bird ? 10 : (sc.night ? 0 : 4);
  for (let i = 0; i < birdCount; i++){
    const bx = (hash(i * 3.3) * W + t * 70 * (0.5 + hash(i))) % (W + 120) - 60;
    const by = H * (0.12 + hash(i * 5.7) * 0.28);
    const bs = 8 + hash(i * 7.1) * 12;
    drawBird(cx, bx, by, bs, sc.night ? '#333' : '#1a1a1a', t * 8 + i);
  }
  if (sc.butterfly){
    for (let i = 0; i < 8; i++){
      const bx = (hash(i * 3.3) * W + Math.sin(t * 0.6 + i) * 80) % W;
      const by = groundY - 120 + Math.cos(t * 0.8 + i) * 50 - hash(i * 5.7) * 80;
      const bs = 10 + hash(i * 7.1) * 8;
      drawButterfly(cx, bx, by, bs, hash(i * 11) * 360, t * 6 + i);
    }
  }
  if (sc.flower){
    for (let i = 0; i < 10; i++){
      const fx = W * (0.05 + hash(i * 3.3) * 0.9);
      const fy = groundY + 30 + hash(i * 5.7) * 60;
      const fs = 12 + hash(i * 7.1) * 12;
      const hue = hash(i * 11) * 360;
      drawFlower(cx, fx, fy, fs, `hsl(${hue},80%,65%)`, '#ffd94a', t + i);
    }
  }
  if (sc.heart){
    for (let i = 0; i < 6; i++){
      const hx = W * (0.15 + hash(i * 3.3) * 0.7);
      const hy = H * (0.2 + hash(i * 5.7) * 0.5) - Math.sin(t * 2 + i) * 20;
      const hs = 18 + hash(i * 7.1) * 18;
      drawHeart(cx, hx, hy, hs, `hsl(${340 + hash(i * 11) * 30},80%,65%)`);
    }
  }
  if (sc.balloon){
    for (let i = 0; i < 7; i++){
      const bx = W * (0.12 + hash(i * 3.3) * 0.76);
      const by = H * 0.35 + Math.sin(t + i) * 15 - hash(i * 5.7) * 130;
      const bs = 20 + hash(i * 7.1) * 12;
      drawBalloon(cx, bx, by, bs, hash(i * 11) * 360, t + i);
    }
  }
  if (sc.person){
    drawPerson(cx, W * 0.3, groundY + 50, 140, sc.night ? '#0a0a0a' : 'rgba(30,30,40,0.95)');
    drawPerson(cx, W * 0.36, groundY + 50, 125, sc.night ? '#0a0a0a' : 'rgba(30,30,40,0.95)');
  }
  if (sc.fire){ drawFireParticles(cx, W, H, t, 140); cx.fillStyle = 'rgba(255,100,30,0.1)'; cx.fillRect(0, 0, W, H); }
  if (sc.rain || sc.storm) drawRain(cx, W, H, t, 250);
  if (sc.snow) drawSnowfall(cx, W, H, t, 250);
  if (sc.storm || sc.snow) drawFog(cx, W, H, t, 0.15);
  if (sc.sunset || sc.sunrise){
    const overlay = cx.createLinearGradient(0, H * 0.3, 0, H);
    overlay.addColorStop(0, 'rgba(255,150,80,0)');
    overlay.addColorStop(0.5, 'rgba(255,120,60,0.08)');
    overlay.addColorStop(1, 'rgba(255,80,40,0.16)');
    cx.fillStyle = overlay; cx.fillRect(0, 0, W, H);
  }
  const vg = cx.createRadialGradient(W/2, H/2, Math.min(W, H) * 0.3,
                                      W/2, H/2, Math.max(W, H) * 0.75);
  vg.addColorStop(0, 'rgba(0,0,0,0)');
  vg.addColorStop(1, 'rgba(0,0,0,0.35)');
  cx.fillStyle = vg;
  cx.fillRect(0, 0, W, H);
}

